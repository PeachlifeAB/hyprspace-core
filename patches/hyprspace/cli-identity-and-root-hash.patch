diff --git a/Sources/Common/configPaths.swift b/Sources/Common/configPaths.swift
new file mode 100644
index 00000000..4fdb2f33
--- /dev/null
+++ b/Sources/Common/configPaths.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+public let hyprspaceHomeOverrideEnv = "HYPRSPACE_HOME_OVERRIDE"
+public let hyprspaceCanonicalConfigFilename = "config.toml"
+
+public func hyprspaceHomeDirectory(environment: [String: String] = ProcessInfo.processInfo.environment) -> URL {
+    if let override = environment[hyprspaceHomeOverrideEnv], !override.isEmpty {
+        return URL(filePath: override)
+    }
+    return FileManager.default.homeDirectoryForCurrentUser
+}
+
+public func hyprspaceCanonicalConfigDirectory(homeDirectory: URL = hyprspaceHomeDirectory()) -> URL {
+    homeDirectory.appending(path: ".config").appending(path: "hyprspace")
+}
+
+public func hyprspaceCanonicalConfigUrl(homeDirectory: URL = hyprspaceHomeDirectory()) -> URL {
+    hyprspaceCanonicalConfigDirectory(homeDirectory: homeDirectory).appending(path: hyprspaceCanonicalConfigFilename)
+}
+
+public func hyprspaceCanonicalConfigExists(fileExists: (String) -> Bool = { FileManager.default.fileExists(atPath: $0) }) -> Bool {
+    fileExists(hyprspaceCanonicalConfigUrl().path)
+}
