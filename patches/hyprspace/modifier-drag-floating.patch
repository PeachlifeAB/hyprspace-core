@@ -0,0 +1,28 @@
+import AppKit
+
+private let mouseDragParserTable: [String: any ParserProtocol<MouseDrag>] = [
+    "enabled": Parser(\.enabled, parseBool),
+    "modifier": Parser(\.modifiers, parseMouseDragModifiers),
+]
+
+func parseMouseDrag(_ rawConfig: OrderedJson, _ backtrace: ConfigBacktrace, _ c: inout ConfigParserContext) -> MouseDrag {
+    parseTable(rawConfig, MouseDrag(), mouseDragParserTable, backtrace, &c)
+}
+
+private func parseMouseDragModifiers(_ raw: OrderedJson, _ backtrace: ConfigBacktrace) -> ResOrConfigParseDiagnostic<NSEvent.ModifierFlags> {
+    parseString(raw, backtrace).flatMap { value in
+        let names = value.split(separator: "-")
+        guard !names.isEmpty else {
+            return .failure(.init(backtrace, "Mouse drag modifier can't be empty"))
+        }
+
+        var result: NSEvent.ModifierFlags = []
+        for name in names {
+            guard let modifier = modifiersMap[String(name)] else {
+                return .failure(.init(backtrace, "Can't parse mouse drag modifier '\(value)'"))
+            }
+            result.formUnion(modifier)
+        }
+        return .success(result)
+    }
+}

diff --git a/Sources/AppBundle/mouse/modifierDrag.swift b/Sources/AppBundle/mouse/modifierDrag.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AppBundle/mouse/modifierDrag.swift
@@ -0,0 +1,233 @@
+@preconcurrency import AppKit
+import Common
+
+private struct MouseDragState {
+    let windowId: UInt32
+    let initialMouse: CGPoint
+    let initialFrame: Rect
+    let wasFloating: Bool
+    var hasStarted: Bool = false
+}
+
+private let mouseDragModifierMask: NSEvent.ModifierFlags = [.option, .control, .command, .shift]
+
+@MainActor private var mouseDragEventTap: CFMachPort? = nil
+@MainActor private var mouseDragEventTapSource: CFRunLoopSource? = nil
+@MainActor private var isSuppressingMouseDragEvents = false
+@MainActor private var mouseDragState: MouseDragState? = nil
+@MainActor private var mouseDragStartTask: Task<(), any Error>? = nil
+@MainActor private var mouseDragUpdateTimer: Timer? = nil
+@MainActor private var pendingMouseDragLocation: CGPoint? = nil
+
+@MainActor
+func syncMouseDrag(_ config: Config) {
+    if config.mouseDrag.enabled == (mouseDragEventTap != nil) { return }
+
+    if !config.mouseDrag.enabled {
+        CGEvent.tapEnable(tap: mouseDragEventTap.orDie(), enable: false)
+        CFRunLoopRemoveSource(CFRunLoopGetMain(), mouseDragEventTapSource.orDie(), .commonModes)
+        mouseDragEventTap = nil
+        mouseDragEventTapSource = nil
+        isSuppressingMouseDragEvents = false
+        cancelMouseDrag()
+        return
+    }
+
+    let mask = (1 << CGEventType.leftMouseDown.rawValue)
+        | (1 << CGEventType.leftMouseDragged.rawValue)
+        | (1 << CGEventType.leftMouseUp.rawValue)
+    guard let eventTap = CGEvent.tapCreate(
+        tap: .cgSessionEventTap,
+        place: .headInsertEventTap,
+        options: .defaultTap,
+        eventsOfInterest: CGEventMask(mask),
+        callback: mouseDragEventTapCallback,
+        userInfo: nil,
+    ) else {
+        return
+    }
+    mouseDragEventTap = eventTap
+    let source = CFMachPortCreateRunLoopSource(kCFAllocatorDefault, eventTap, 0)
+    mouseDragEventTapSource = source
+    CFRunLoopAddSource(CFRunLoopGetMain(), source, .commonModes)
+    CGEvent.tapEnable(tap: eventTap, enable: true)
+}
+
+private nonisolated let mouseDragEventTapCallback: CGEventTapCallBack = { _, type, cgEvent, _ in
+    if type == .tapDisabledByTimeout || type == .tapDisabledByUserInput {
+        Task { @MainActor in
+            isSuppressingMouseDragEvents = false
+            cancelMouseDrag(at: mouseLocation)
+            if let eventTap = mouseDragEventTap {
+                CGEvent.tapEnable(tap: eventTap, enable: true)
+            }
+        }
+        return Unmanaged.passUnretained(cgEvent)
+    }
+
+    guard let event = NSEvent(cgEvent: cgEvent) else { return Unmanaged.passUnretained(cgEvent) }
+    let suppress = MainActor.assumeIsolated {
+        switch type {
+            case .leftMouseDown:
+                isSuppressingMouseDragEvents =
+                    event.modifierFlags.intersection(mouseDragModifierMask) == config.mouseDrag.modifiers
+                if isSuppressingMouseDragEvents { beginMouseDrag(event) }
+            case .leftMouseDragged:
+                if isSuppressingMouseDragEvents { continueMouseDrag(event) }
+            case .leftMouseUp:
+                if isSuppressingMouseDragEvents {
+                    cancelMouseDrag(at: event.locationInWindow.withYAxisFlipped)
+                }
+            default: break
+        }
+        let suppress = isSuppressingMouseDragEvents
+        if type == .leftMouseUp { isSuppressingMouseDragEvents = false }
+        return suppress
+    }
+    return suppress ? nil : Unmanaged.passUnretained(cgEvent)
+}
+
+@MainActor
+func isMouseDragWindow(_ windowId: UInt32) -> Bool {
+    mouseDragState?.windowId == windowId && mouseDragState?.hasStarted == true
+}
+
+@MainActor
+private func beginMouseDrag(_ event: NSEvent) {
+    guard event.modifierFlags.intersection(mouseDragModifierMask) == config.mouseDrag.modifiers else { return }
+
+    cancelMouseDrag()
+    let initialMouse = event.locationInWindow.withYAxisFlipped
+    mouseDragStartTask = Task.startUnstructured { @MainActor in
+        guard RunSessionGuard.isServerEnabled != nil else { return }
+        guard let windowId = await windowId(at: initialMouse), let window = Window.get(byId: windowId) else { return }
+        try checkCancellation()
+        guard let initialFrame = try await window.getAxRect(.cancellable) else { return }
+        try checkCancellation()
+        guard window.nodeWorkspace != nil else { return }
+
+        switch window.windowParentCases {
+            case .tilingContainer, .floatingWindowsContainer: break
+            case .unbound, .macosFullscreenWindowsContainer, .macosMinimizedWindowsContainer,
+                 .macosPopupWindowsContainer, .macosHiddenAppsWindowsContainer: return
+        }
+
+        mouseDragState = MouseDragState(
+            windowId: window.windowId,
+            initialMouse: initialMouse,
+            initialFrame: initialFrame,
+            wasFloating: window.isFloating,
+        )
+    }
+}
+
+@MainActor
+private func continueMouseDrag(_ event: NSEvent) {
+    guard var state = mouseDragState, let window = Window.get(byId: state.windowId) else {
+        cancelMouseDrag()
+        return
+    }
+
+    if !state.hasStarted {
+        guard let workspace = window.nodeWorkspace else {
+            cancelMouseDrag()
+            return
+        }
+        state.hasStarted = true
+        mouseDragState = state
+        window.isFullscreen = false
+        if !window.isFloating {
+            window.bindAsFloatingWindow(to: workspace)
+        }
+        currentlyManipulatedWithMouseWindowId = window.windowId
+        _ = window.focusWindow()
+        window.nativeFocus()
+        scheduleCancellableCompleteRefreshSession(.globalObserver("mouseDragStarted"), optimisticallyPreLayoutWorkspaces: true)
+    }
+
+    pendingMouseDragLocation = event.locationInWindow.withYAxisFlipped
+    if mouseDragUpdateTimer == nil {
+        applyPendingMouseDragUpdate()
+        mouseDragUpdateTimer = Timer.scheduledTimer(withTimeInterval: 1 / 60, repeats: true) { _ in
+            MainActor.assumeIsolated {
+                applyPendingMouseDragUpdate()
+            }
+        }
+    }
+}
+
+@MainActor
+private func applyPendingMouseDragUpdate() {
+    guard let currentMouse = pendingMouseDragLocation else { return }
+    pendingMouseDragLocation = nil
+    guard let state = mouseDragState, let window = Window.get(byId: state.windowId) else {
+        cancelMouseDrag()
+        return
+    }
+    let topLeft = mouseDragTopLeft(
+        initialWindowTopLeft: state.initialFrame.topLeftCorner,
+        initialMouse: state.initialMouse,
+        currentMouse: currentMouse,
+    )
+    window.setAxFrame(topLeft, nil)
+
+    let center = CGPoint(x: topLeft.x + state.initialFrame.width / 2, y: topLeft.y + state.initialFrame.height / 2)
+    let targetWorkspace = center.monitorApproximation.activeWorkspace
+    if window.nodeWorkspace != targetWorkspace {
+        window.bindAsFloatingWindow(to: targetWorkspace)
+    }
+}
+
+@MainActor
+private func cancelMouseDrag(at dropLocation: CGPoint = mouseLocation) {
+    mouseDragStartTask?.cancel()
+    mouseDragStartTask = nil
+    mouseDragUpdateTimer?.invalidate()
+    mouseDragUpdateTimer = nil
+    applyPendingMouseDragUpdate()
+    pendingMouseDragLocation = nil
+    guard let state = mouseDragState else { return }
+    mouseDragState = nil
+    guard state.hasStarted else { return }
+    if !state.wasFloating, let window = Window.get(byId: state.windowId) {
+        tileDraggedWindow(window, at: dropLocation)
+    }
+    currentlyManipulatedWithMouseWindowId = nil
+    scheduleCancellableCompleteRefreshSession(.globalObserver("mouseDragEnded"))
+}
+
+@MainActor
+private func tileDraggedWindow(_ window: Window, at location: CGPoint) {
+    let workspace = location.monitorApproximation.activeWorkspace
+    let target = location
+        .findWindowRecursively(in: workspace.rootTilingContainer, virtual: false, fullscreenCoversAll: false)?
+        .takeIf { $0 != window }
+
+    guard let target,
+          let parent = target.parent as? TilingContainer,
+          let targetRect = target.lastAppliedLayoutPhysicalRect,
+          let targetIndex = target.ownIndex
+    else {
+        window.bind(to: workspace.rootTilingContainer, adaptiveWeight: WEIGHT_AUTO, index: INDEX_BIND_LAST)
+        return
+    }
+
+    let insertAfter = location.getProjection(parent.orientation) >= targetRect.center.getProjection(parent.orientation)
+    window.bind(to: parent, adaptiveWeight: WEIGHT_AUTO, index: targetIndex + (insertAfter ? 1 : 0))
+}
+
+func mouseDragTopLeft(initialWindowTopLeft: CGPoint, initialMouse: CGPoint, currentMouse: CGPoint) -> CGPoint {
+    initialWindowTopLeft + currentMouse - initialMouse
+}
+
+@concurrent
+private nonisolated func windowId(at location: CGPoint) async -> UInt32? {
+    let systemwide = AXUIElementCreateSystemWide()
+    var element: AXUIElement?
+    guard unsafe AXUIElementCopyElementAtPosition(systemwide, Float(location.x), Float(location.y), &element) == .success,
+          let element
+    else { return nil }
+
+    let window = element.get(Ax.parentWindowRecursive) ?? (element.get(Ax.roleAttr) == kAXWindowRole ? element : nil)
+    return window?.containingWindowId()
+}

