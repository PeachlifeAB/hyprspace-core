+++ b/Sources/AppBundleTests/mouse/ModifierDragTest.swift
@@ -0,0 +1,13 @@
+@testable import AppBundle
+import XCTest
+
+final class ModifierDragTest: XCTestCase {
+    func testDragPreservesGrabOffset() {
+        let topLeft = mouseDragTopLeft(
+            initialWindowTopLeft: CGPoint(x: 100, y: 200),
+            initialMouse: CGPoint(x: 250, y: 300),
+            currentMouse: CGPoint(x: 300, y: 380),
+        )
+        assertEquals(topLeft, CGPoint(x: 150, y: 280))
+    }
+}

