# Summary: Adds new-window-or-open, which opens an app if it is closed and triggers its menu-bar “New Window” action if it is already running.

diff --git a/Sources/AppBundle/command/impl/NewWindowOrOpenCommand.swift b/Sources/AppBundle/command/impl/NewWindowOrOpenCommand.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AppBundle/command/impl/NewWindowOrOpenCommand.swift
@@ -0,0 +1,45 @@
+import AppKit
+import Common
+import Foundation
+
+struct NewWindowOrOpenCommand: Command {
+    let args: NewWindowOrOpenCmdArgs
+    /*conforms*/ let shouldResetClosedWindowsCache = false
+    /*conforms*/ let shouldRefreshModel = false
+    /*conforms*/ let shouldRunInLightSession = false
+
+    @MainActor
+    func run(_ env: CmdEnv, _ io: CmdIo) async throws -> Bool {
+        guard let app = NSWorkspace.shared.runningApplications.first(where: {
+            $0.localizedName == args.appName.val || $0.bundleIdentifier == args.appName.val
+        }) else {
+            let process = try Process.run(URL(filePath: "/usr/bin/open"), arguments: ["-a", args.appName.val])
+            process.waitUntilExit()
+            return process.terminationReason == .exit && process.terminationStatus == 0
+        }
+        let appName = app.localizedName ?? args.appName.val
+        app.activate(options: .activateIgnoringOtherApps)
+        let script = """
+tell application "System Events"
+    tell process "\(appName)"
+        set frontmost to true
+        delay 0.2
+        set fileItems to name of menu items 1 thru 2 of menu 1 of menu bar item "File" of menu bar 1
+        repeat with itemName in fileItems
+            if itemName contains "New" then
+                click menu item (itemName as text) of menu 1 of menu bar item "File" of menu bar 1
+                return
+            end if
+        end repeat
+        error "no New item found in first two File menu items"
+    end tell
+end tell
+"""
+        let result = try Process.run(URL(filePath: "/usr/bin/osascript"), arguments: ["-e", script])
+        result.waitUntilExit()
+        guard result.terminationReason == .exit && result.terminationStatus == 0 else {
+            return io.err("Could not open new window for '\(args.appName.val)'")
+        }
+        return true
+    }
+}

