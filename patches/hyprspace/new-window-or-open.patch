+import Foundation
+
+public struct NewWindowOrOpenCmdArgs: CmdArgs {
+    public let rawArgsForStrRepr: EquatableNoop<StrArrSlice>
+    public init(rawArgs: StrArrSlice) { self.rawArgsForStrRepr = .init(rawArgs) }
+    public static let parser: CmdParser<Self> = cmdParser(
+        kind: .newWindowOrOpen,
+        allowInConfig: false,
+        help: "USAGE: aerospace new-window-or-open <app-name>",
+        flags: [:],
+        posArgs: [newArgParser(\.appName, consumeStrCliArg, mandatoryArgPlaceholder: "<app-name>")]
+    )
+
+    /*conforms*/ public var windowId: UInt32?
+    /*conforms*/ public var workspaceName: WorkspaceName?
+    public var appName: Lateinit<String> = .uninitialized
+}

