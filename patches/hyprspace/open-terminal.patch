+@testable import AppBundle
+import Common
+import XCTest
+
+final class OpenTerminalCommandTest: XCTestCase {
+    func testParse() {
+        testParseSingleCommandSucc(
+            "open-terminal Ghostty btop",
+            OpenTerminalCmdArgs(rawArgs: []).copy(\.appName, .initialized("Ghostty")).copy(\.command, .initialized("btop"))
+        )
+        testParseSingleCommandSucc(
+            "open-terminal Terminal.app \"vim /tmp/foo\"",
+            OpenTerminalCmdArgs(rawArgs: []).copy(\.appName, .initialized("Terminal.app")).copy(\.command, .initialized("vim /tmp/foo"))
+        )
+        testParseSingleCommandSucc(
+            "open-terminal --new Ghostty btop",
+            OpenTerminalCmdArgs(rawArgs: []).copy(\.newInstance, true).copy(\.appName, .initialized("Ghostty")).copy(\.command, .initialized("btop"))
+        )
+        assertEquals(
+            parseCommand("open-terminal").errorOrNil,
+            "ERROR: Argument '<app-name>' is mandatory\nERROR: Argument '<command>' is mandatory"
+        )
+        assertEquals(
+            parseCommand("open-terminal Ghostty").errorOrNil,
+            "ERROR: Argument '<command>' is mandatory"
+        )
+    }
+
+    func testNewWindowAlias() {
+        // new-window is an alias for new-window-or-open
+        testParseSingleCommandSucc(
+            "new-window Ghostty",
+            NewWindowOrOpenCmdArgs(rawArgs: []).copy(\.appName, .initialized("Ghostty"))
+        )
+    }
+}

