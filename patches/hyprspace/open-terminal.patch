+import AppKit
+import Common
+import Foundation
+
+struct OpenTerminalCommand: Command {
+    let args: OpenTerminalCmdArgs
+    /*conforms*/ let shouldResetClosedWindowsCache = false
+    /*conforms*/ let shouldRefreshModel = false
+    /*conforms*/ let shouldRunInLightSession = false
+
+    @MainActor
+    func run(_ env: CmdEnv, _ io: CmdIo) async -> BinaryExitCode {
+        do {
+            if let postOpenAction = args.postOpenAction {
+                guard let windowId = try await OpenTerminalFlow.performAndResolveWindowId(appName: args.appName.val, command: args.command.val, newInstance: args.newInstance, env: env, io: io) else {
+                    return .fail
+                }
+                return await run(postOpenAction, on: windowId, env, io)
+            }
+            return .from(bool: try await OpenTerminalFlow.perform(appName: args.appName.val, command: args.command.val, newInstance: args.newInstance, env: env, io: io))
+        } catch {
+            return .fail(io.err("\(error)"))
+        }
+    }
+
+    @MainActor
+    private func run(_ postOpenAction: NewWindowOrOpenPostOpenAction, on windowId: UInt32, _ env: CmdEnv, _ io: CmdIo) async -> BinaryExitCode {
+        switch postOpenAction {
+            case .position(let placement):
+                var positionArgs = PositionCmdArgs(rawArgs: [])
+                positionArgs.targetPlacement = .initialized(placement)
+                return await PositionCommand(args: positionArgs.copy(\.windowId, windowId)).run(env, io)
+        }
+    }
+}

diff --git a/Sources/AppBundle/command/impl/OpenTerminalFlow.swift b/Sources/AppBundle/command/impl/OpenTerminalFlow.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AppBundle/command/impl/OpenTerminalFlow.swift
@@ -0,0 +1,163 @@
+import AppKit
+import Common
+import Darwin
+import Foundation
+
+enum OpenTerminalFlow {
+    @MainActor
+    static func perform(appName: String, command: String, newInstance: Bool, env: CmdEnv, io: CmdIo) async throws -> Bool {
+        guard let bundleId = resolvedBundleId(for: appName) else {
+            io.err("open-terminal only supports Ghostty and Terminal.app, got '\(appName)'"); return false
+        }
+        if newInstance {
+            return launchNewInstance(bundleId: bundleId, command: command, io: io)
+        }
+        return runWithCommand(bundleId: bundleId, command: command, io: io)
+    }
+
+    @MainActor
+    static func performAndResolveWindowId(appName: String, command: String, newInstance: Bool, env: CmdEnv, io: CmdIo) async throws -> UInt32? {
+        guard let bundleId = resolvedBundleId(for: appName) else {
+            _ = io.err("open-terminal only supports Ghostty and Terminal.app, got '\(appName)'")
+            return nil
+        }
+        let previousAllWindowIds = try await allAliveWindowIds()
+        let success = newInstance
+            ? launchNewInstance(bundleId: bundleId, command: command, io: io)
+            : runWithCommand(bundleId: bundleId, command: command, io: io)
+        guard success else { return nil }
+        guard let windowId = try await waitForNewFocusedWindowId(previousWindowIds: previousAllWindowIds) else {
+            _ = io.err("Failed to identify the newly opened window for '\(appName)'")
+            return nil
+        }
+        return windowId
+    }
+
+    private static func resolvedBundleId(for appName: String) -> String? {
+        let name = appName.lowercased()
+        let ghosttyNames: Set<String> = ["ghostty", "ghostty.app", KnownBundleId.ghostty.rawValue]
+        let terminalNames: Set<String> = ["terminal", "terminal.app", "com.apple.terminal"]
+        if ghosttyNames.contains(name) { return KnownBundleId.ghostty.rawValue }
+        if terminalNames.contains(name) { return "com.apple.terminal" }
+        return nil
+    }
+
+    // Default mode: reuse running app via AppleScript (works running or not)
+    private static func runWithCommand(bundleId: String, command: String, io: CmdIo) -> Bool {
+        let shell = userDefaultShell()
+        let shellCommand = "\(appleScriptEscape(shell)) -ilc \(appleScriptEscape(shellQuote(command + "; exec -l \(shellQuote(shell))")))"
+
+        let script: String
+        if bundleId == KnownBundleId.ghostty.rawValue {
+            script = """
+            tell application "Ghostty"
+                set cfg to new surface configuration
+                set command of cfg to "\(shellCommand)"
+                new window with configuration cfg
+            end tell
+            """
+        } else {
+            // Pattern from Apple docs and bgtail: launch (no window), create an
+            // empty tab and capture its reference, then run the command in that
+            // exact tab. Avoids the double-window race when Terminal cold-starts.
+            script = """
+            tell application "Terminal"
+                launch
+                set createdTab to do script ""
+                do script "\(shellCommand)" in createdTab
+                activate
+            end tell
+            """
+        }
+        return runOsascript(script: script, bundleId: bundleId, io: io)
+    }
+
+    // --new mode: force a fresh app instance via open -n
+    private static func launchNewInstance(bundleId: String, command: String, io: CmdIo) -> Bool {
+        let shell = userDefaultShell()
+
+        if bundleId == KnownBundleId.ghostty.rawValue {
+            // Ghostty accepts -e <cmd> via --args; open -n forces a new instance
+            let process = Process()
+            process.executableURL = URL(filePath: "/usr/bin/open")
+            process.arguments = ["-na", "Ghostty", "--args", "-e", shell, "-ilc", command + "; exec -l " + shellQuote(shell)]
+            do {
+                try process.run()
+                process.waitUntilExit()
+                guard process.terminationReason == .exit && process.terminationStatus == 0 else {
+                    io.err("open-terminal --new: open exited with status \(process.terminationStatus)"); return false
+                }
+                return true
+            } catch {
+                io.err("open-terminal --new: \(error.localizedDescription)"); return false
+            }
+        }
+
+        // Terminal.app cannot be launched as a clean new instance with a custom
+        // command in one window: it always opens its default window on cold spawn,
+        // and AppleScript can't target a specific Terminal process. Refuse.
+        io.err("open-terminal --new: Terminal.app does not support clean new-instance launches. Use Ghostty for --new, or run open-terminal without --new for a new window."); return false
+    }
+
+    private static func runOsascript(script: String, bundleId: String, io: CmdIo) -> Bool {
+        let process = Process()
+        process.executableURL = URL(filePath: "/usr/bin/osascript")
+        process.arguments = ["-e", script]
+        do {
+            try process.run()
+            process.waitUntilExit()
+            guard process.terminationReason == .exit && process.terminationStatus == 0 else {
+                io.err("open-terminal: osascript exited with status \(process.terminationStatus) for '\(bundleId)'"); return false
+            }
+            return true
+        } catch {
+            io.err("open-terminal: \(error.localizedDescription)"); return false
+        }
+    }
+
+    private static func shellQuote(_ s: String) -> String {
+        "'" + s.replacingOccurrences(of: "'", with: "'\\''") + "'"
+    }
+
+    private static func appleScriptEscape(_ s: String) -> String {
+        s.replacingOccurrences(of: "\\", with: "\\\\")
+         .replacingOccurrences(of: "\"", with: "\\\"")
+    }
+
+    private static func userDefaultShell() -> String {
+        if let pw = getpwuid(getuid()), let shell = pw.pointee.pw_shell {
+            return String(cString: shell)
+        }
+        return "/bin/sh"
+    }
+
+    @MainActor
+    private static func allAliveWindowIds() async throws -> Set<UInt32> {
+        let mapping = try await MacApp.refreshAllAndGetAliveWindowIds(frontmostAppBundleId: NSWorkspace.shared.frontmostApplication?.bundleIdentifier)
+        var result: Set<UInt32> = []
+        for (app, windowIds) in mapping {
+            if app.rawAppBundleId != nil {
+                for windowId in windowIds {
+                    _ = try await MacWindow.getOrRegister(windowId: windowId, macApp: app)
+                    result.insert(windowId)
+                }
+            }
+        }
+        return result
+    }
+
+    @MainActor
+    private static func waitForNewFocusedWindowId(previousWindowIds: Set<UInt32>) async throws -> UInt32? {
+        for _ in 0..<40 {
+            try await Task.sleep(nanoseconds: 100_000_000)
+            let newWindowIds = try await allAliveWindowIds().subtracting(previousWindowIds)
+            if let focusedWindow = focus.windowOrNil, newWindowIds.contains(focusedWindow.windowId) {
+                return focusedWindow.windowId
+            }
+            if let windowId = newWindowIds.singleOrNil() {
+                return windowId
+            }
+        }
+        return nil
+    }
+}

