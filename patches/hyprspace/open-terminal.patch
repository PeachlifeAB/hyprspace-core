+import Foundation
+
+public struct OpenTerminalCmdArgs: CmdArgs {
+    /*conforms*/ public var commonState: CmdArgsCommonState
+    public init(rawArgs: StrArrSlice) { self.commonState = .init(rawArgs) }
+    public static let parser: CmdParser<Self> = .init(
+        kind: .openTerminal,
+        help: "USAGE: aerospace open-terminal [--new] <app-name> <command> [position <preset>]",
+        flags: [
+            "--new": trueBoolFlag(\.newInstance),
+        ],
+        posArgs: [
+            newMandatoryPosArgParser(\.appName, consumeStrCliArg, placeholder: "<app-name>"),
+            newMandatoryPosArgParser(\.command, consumeStrCliArg, placeholder: "<command>"),
+            ArgParser(\.postOpenAction, parseNewWindowOrOpenPostOpenAction),
+        ]
+    )
+
+    public var newInstance: Bool = false
+    public var appName: Lateinit<String> = .uninitialized
+    public var command: Lateinit<String> = .uninitialized
+    public var postOpenAction: NewWindowOrOpenPostOpenAction? = nil
+}

diff --git a/docs/aerospace-open-terminal.adoc b/docs/aerospace-open-terminal.adoc
new file mode 100644
--- /dev/null
+++ b/docs/aerospace-open-terminal.adoc
@@ -0,0 +1,26 @@
+= open-terminal(1)
+
+== Name
+
+open-terminal - open a terminal with a command, reusing the running app or launching a fresh instance
+
+== Synopsis
+
+`aerospace open-terminal [--new] <app-name> <command> [position <preset>]`
+
+== Description
+
+Opens a new window in the specified terminal app and runs the given command inside it.
+Supports Ghostty and Terminal.app. The app is launched if not already running.
+
+The command is executed via the user's default login shell so that PATH and shell configuration are loaded.
+
+By default, reuses the running app: Ghostty via AppleScript `new window with configuration`, Terminal.app via `do script`.
+
+With `--new`, forces a fresh app instance via `open -n`.
+
+If `position <preset>` is provided, the newly opened window is placed using the requested floating preset.
+
+Example: `aerospace open-terminal Ghostty btop`
+Example: `aerospace open-terminal Terminal.app "vim ~/.config/hyprspace/config.toml"`
+Example: `aerospace open-terminal --new Ghostty "vim /tmp/scratch.md"`
