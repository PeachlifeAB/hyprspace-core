diff --git a/Sources/AppBundleTests/config/ConfigFileTest.swift b/Sources/AppBundleTests/config/ConfigFileTest.swift
new file mode 100644
index 00000000..3a970f7e
--- /dev/null
+++ b/Sources/AppBundleTests/config/ConfigFileTest.swift
@@ -0,0 +1,67 @@
+@testable import AppBundle
+import XCTest
+
+final class ConfigFileTest: XCTestCase {
+    func testCanonicalConfigDirectoryUsesDotConfigUnderHome() {
+        let home = URL(filePath: "/tmp/test-home")
+        XCTAssertEqual(canonicalConfigDirectory(homeDirectory: home).path, "/tmp/test-home/.config/hyprspace")
+        XCTAssertEqual(canonicalConfigUrl(homeDirectory: home).path, "/tmp/test-home/.config/hyprspace/config.toml")
+    }
+
+    func testCompatibilityConfigUrls() {
+        let home = URL(filePath: "/tmp/test-home")
+        XCTAssertEqual(
+            compatibilityConfigUrls(homeDirectory: home).map(\.path),
+            [
+                "/tmp/test-home/.hyprspace.toml",
+                "/tmp/test-home/Library/Application Support/Hyprspace/config.toml",
+            ],
+        )
+    }
+
+    func testCanonicalConfigWinsOverCompatibilityPaths() {
+        let canonical = URL(filePath: "/tmp/home/.config/hyprspace/config.toml")
+        let compatibility = [
+            URL(filePath: "/tmp/home/.hyprspace.toml"),
+            URL(filePath: "/tmp/home/Library/Application Support/Hyprspace/config.toml"),
+        ]
+        let selected = selectCustomConfigUrl(
+            forceConfigUrl: nil,
+            canonicalConfigUrl: canonical,
+            compatibilityCandidates: compatibility,
+            fileExists: { _ in true },
+        )
+        XCTAssertEqual(selected.urlOrNil?.path, canonical.path)
+    }
+
+    func testSingleCompatibilityPathIsUsedWhenCanonicalIsMissing() {
+        let canonical = URL(filePath: "/tmp/home/.config/hyprspace/config.toml")
+        let dotfile = URL(filePath: "/tmp/home/.hyprspace.toml")
+        let appSupport = URL(filePath: "/tmp/home/Library/Application Support/Hyprspace/config.toml")
+        let selected = selectCustomConfigUrl(
+            forceConfigUrl: nil,
+            canonicalConfigUrl: canonical,
+            compatibilityCandidates: [dotfile, appSupport],
+            fileExists: { $0 == dotfile },
+        )
+        XCTAssertEqual(selected.urlOrNil?.path, dotfile.path)
+    }
+
+    func testCompatibilityPathsAreAmbiguousWhenCanonicalIsMissing() {
+        let canonical = URL(filePath: "/tmp/home/.config/hyprspace/config.toml")
+        let dotfile = URL(filePath: "/tmp/home/.hyprspace.toml")
+        let appSupport = URL(filePath: "/tmp/home/Library/Application Support/Hyprspace/config.toml")
+        let selected = selectCustomConfigUrl(
+            forceConfigUrl: nil,
+            canonicalConfigUrl: canonical,
+            compatibilityCandidates: [dotfile, appSupport],
+            fileExists: { $0 == dotfile || $0 == appSupport },
+        )
+        switch selected {
+            case .ambiguousConfigError(let urls):
+                XCTAssertEqual(urls.map(\.path), [dotfile.path, appSupport.path])
+            default:
+                XCTFail("Expected ambiguous config error")
+        }
+    }
+}
