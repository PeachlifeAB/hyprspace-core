diff --git a/Sources/AppBundle/command/impl/NewWindowOrOpenFlow.swift b/Sources/AppBundle/command/impl/NewWindowOrOpenFlow.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AppBundle/command/impl/NewWindowOrOpenFlow.swift
@@ -0,0 +1,189 @@
+import AppKit
+import Common
+import Foundation
+
+enum NewWindowOrOpenFlow {
+    @MainActor
+    static func perform(appName: String, env: CmdEnv, io: CmdIo) async throws -> Bool {
+        if let runningApp = runningApplication(named: appName) {
+            return try await triggerNewWindow(for: runningApp, env: env, io: io)
+        } else {
+            return launchApplication(named: appName, io: io)
+        }
+    }
+
+    @MainActor
+    static func performAndResolveWindowId(appName: String, env: CmdEnv, io: CmdIo) async throws -> UInt32? {
+        let runningApp = runningApplication(named: appName)
+        let previousWindowIds = try await knownWindowIds(appBundleId: runningApp?.bundleIdentifier)
+        let previousAllWindowIds = try await allAliveWindowIds()
+        guard try await perform(appName: appName, env: env, io: io) else {
+            return nil
+        }
+        let windowId = if let appBundleId = runningApp?.bundleIdentifier {
+            try await waitForNewWindowId(appBundleId: appBundleId, previousWindowIds: previousWindowIds)
+        } else {
+            try await waitForNewFocusedWindowId(previousWindowIds: previousAllWindowIds)
+        }
+        guard let windowId else {
+            _ = io.err("Failed to identify the newly opened window for '\(appName)'")
+            return nil
+        }
+        return windowId
+    }
+
+    @MainActor
+    private static func runningApplication(named appName: String) -> NSRunningApplication? {
+        let candidateNames = normalizedApplicationNames(from: appName)
+        return NSWorkspace.shared.runningApplications.first { app in
+            if let localizedName = app.localizedName?.lowercased(), candidateNames.contains(localizedName) {
+                return true
+            }
+            if let bundleIdentifier = app.bundleIdentifier?.lowercased(), candidateNames.contains(bundleIdentifier) {
+                return true
+            }
+            return false
+        }
+    }
+
+    private static func normalizedApplicationNames(from appName: String) -> Set<String> {
+        let loweredAppName = appName.lowercased()
+        var candidateNames: Set<String> = [loweredAppName]
+        if loweredAppName.hasSuffix(".app") {
+            candidateNames.insert(String(loweredAppName.dropLast(4)))
+        }
+        return candidateNames
+    }
+
+    @MainActor
+    private static func triggerNewWindow(for app: NSRunningApplication, env: CmdEnv, io: CmdIo) async throws -> Bool {
+        guard let bundleId = app.bundleIdentifier else {
+            return io.err("Could not find bundle ID for running application '\(app.localizedName ?? "Unknown app")'")
+        }
+
+        let callerWorkspace = focus.workspace
+        let previousWindowIds = try await knownWindowIds(appBundleId: bundleId)
+
+        guard let leaves = try await activateAppAndCollectMenuLeaves(bundleId: bundleId, io: io) else {
+            return false
+        }
+
+        guard let leaf = selectNewWindowLeaf(from: leaves, appName: app.localizedName ?? "") else {
+            return io.err("No matching new-window menu item found for '\(app.localizedName ?? bundleId)'")
+        }
+        AXUIElementPerformAction(leaf.element, kAXPressAction as CFString)
+        guard let newWindowId = try await waitForNewWindowId(appBundleId: bundleId, previousWindowIds: previousWindowIds),
+              let newWindow = Window.get(byId: newWindowId)
+        else {
+ _ = callerWorkspace.focusWorkspace()
+ return true
+ }
+
+ if newWindow.nodeWorkspace != callerWorkspace {
+            _ = moveWindowToWorkspace(newWindow, callerWorkspace, io, focusFollowsWindow: true, failIfNoop: false)
+        } else {
+            _ = callerWorkspace.focusWorkspace()
+        }
+        return true
+    }
+
+    private static func launchApplication(named appName: String, io: CmdIo) -> Bool {
+        let process = Process()
+        process.executableURL = URL(filePath: "/usr/bin/open")
+        process.arguments = ["-a", appName]
+
+        do {
+            try process.run()
+            process.waitUntilExit()
+            guard process.terminationReason == .exit && process.terminationStatus == 0 else {
+                return io.err("Failed to open application '\(appName)': open exited with status \(process.terminationStatus) and reason \(process.terminationReason.rawValue)")
+            }
+            return true
+        } catch {
+            return io.err("Failed to open application '\(appName)': \(error.localizedDescription)")
+        }
+    }
+
+    @MainActor
+    private static func knownWindowIds(appBundleId: String?) async throws -> Set<UInt32> {
+        guard let appBundleId else { return [] }
+        return try await aliveWindowIdsByBundleId()[appBundleId] ?? []
+    }
+
+    @MainActor
+    private static func allAliveWindowIds() async throws -> Set<UInt32> {
+        Set(try await aliveWindowIdsByBundleId().values.flatMap { $0 })
+    }
+
+    @MainActor
+    private static func aliveWindowIdsByBundleId() async throws -> [String: Set<UInt32>] {
+        let mapping = try await MacApp.refreshAllAndGetAliveWindowIds(frontmostAppBundleId: NSWorkspace.shared.frontmostApplication?.bundleIdentifier)
+        var result: [String: Set<UInt32>] = [:]
+        for (app, windowIds) in mapping {
+            if let bundleId = app.rawAppBundleId {
+                for windowId in windowIds {
+                    _ = try await MacWindow.getOrRegister(windowId: windowId, macApp: app)
+                }
+                result[bundleId] = Set(windowIds)
+            }
+        }
+        return result
+    }
+
+ @MainActor
+ private static func waitForNewWindowId(appBundleId: String, previousWindowIds: Set<UInt32>) async throws -> UInt32? {
+ for _ in 0..<40 {
+            try await Task.sleep(nanoseconds: 100_000_000)
+
+            let newWindowIds = try await knownWindowIds(appBundleId: appBundleId).subtracting(previousWindowIds)
+            if let windowId = newWindowIds.singleOrNil() {
+                return windowId
+            }
+            if let focusedWindow = focus.windowOrNil,
+               newWindowIds.contains(focusedWindow.windowId),
+               focusedWindow.app.rawAppBundleId == appBundleId {
+                return focusedWindow.windowId
+            }
+        }
+        return nil
+    }
+
+    @MainActor
+    private static func waitForNewFocusedWindowId(previousWindowIds: Set<UInt32>) async throws -> UInt32? {
+        for _ in 0..<40 {
+            try await Task.sleep(nanoseconds: 100_000_000)
+
+            let newWindowIds = try await allAliveWindowIds().subtracting(previousWindowIds)
+            if let focusedWindow = focus.windowOrNil, newWindowIds.contains(focusedWindow.windowId) {
+                return focusedWindow.windowId
+            }
+            if let windowId = newWindowIds.singleOrNil() {
+                return windowId
+            }
+        }
+        return nil
+    }
+}
+
+func selectNewWindowLeaf(from leaves: [AppMenuLeaf], appName: String) -> AppMenuLeaf? {
+    let loweredAppName = appName.lowercased()
+    let preferredLeaves = ["new \(loweredAppName) window"]
+
+    for preferredLeaf in preferredLeaves {
+        if let match = leaves.first(where: { $0.leaf.lowercased() == preferredLeaf }) {
+            return match
+        }
+    }
+
+    if let genericNewWindow = leaves.first(where: {
+        let loweredLeaf = $0.leaf.lowercased()
+        return loweredLeaf.hasPrefix("new window")
+    }) {
+        return genericNewWindow
+    }
+
+    return leaves.first(where: {
+        let loweredLeaf = $0.leaf.lowercased()
+        return $0.fullPath.lowercased().hasPrefix("file / new") && loweredLeaf.contains("window")
+    })
+}

diff --git a/docs/aerospace-new-window-or-open.adoc b/docs/aerospace-new-window-or-open.adoc
--- a/docs/aerospace-new-window-or-open.adoc
+++ b/docs/aerospace-new-window-or-open.adoc
@@ -6,9 +6,13 @@
 
 == Synopsis
 
-`aerospace new-window-or-open <app-name>`
+`aerospace new-window-or-open <app-name> [position <preset>]`
 
 == Description
 
 If the target app is already running, open a new window by clicking the first File menu item containing "New".
 If the app is not running, launch it by app name and return.
+
+If `position <preset>` is provided, the newly opened window is placed using the requested floating preset.
+
+Example: `aerospace new-window-or-open "Finder" position center`
