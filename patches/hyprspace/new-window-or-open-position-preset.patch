+/// Command-specific parser for `new-window-or-open` and its `new-window` alias.
+///
+/// Unlike the generic `parseSpecificCmdArgs` loop, this parser treats the first
+/// dash-prefixed token as the application-argument boundary rather than a
+/// Hyprspace flag. Dash-prefixed tokens and everything after them are stored
+/// opaquely as launch tokens; only the reserved `position <preset>` action is
+/// extracted as a Hyprspace-owned post-open action.
+func parseNewWindowOrOpenCmdArgs(_ args: StrArrSlice) -> ParsedCmd<NewWindowOrOpenCmdArgs> {
+    let arr = args.toArray()
+
+    if arr.first == "-h" || arr.first == "--help" {
+        return .help(NewWindowOrOpenCmdArgs.info.help)
+    }
+    if arr.isEmpty {
+        return .failure("ERROR: Argument '<app-name>' is mandatory")
+    }
+
+    var tokens = arr
+    var postOpenAction: NewWindowOrOpenCmdArgs.PostOpenAction? = nil
+
+    // Reserved terminal suffix: `position <preset>` as the final two tokens.
+    if tokens.count >= 2, tokens[tokens.count - 2] == "position" {
+        switch parseEnum(tokens.last!, PositionCmdArgs.Placement.self) {
+            case .success(let placement):
+                postOpenAction = .position(placement)
+                tokens.removeLast(2)
+            case .failure(let error):
+                return .failure(error)
+        }
+    }
+
+    // Reserved pre-argument action: `position <preset>` immediately before the
+    // first separate dash-prefixed launch token.
+    if postOpenAction == nil,
+       let firstDashIdx = tokens.firstIndex(where: { $0.isCliDashFlag }),
+       firstDashIdx >= 2,
+       tokens[firstDashIdx - 2] == "position"
+    {
+        switch parseEnum(tokens[firstDashIdx - 1], PositionCmdArgs.Placement.self) {
+            case .success(let placement):
+                postOpenAction = .position(placement)
+                tokens.removeSubrange(firstDashIdx - 2 ..< firstDashIdx)
+            case .failure(let error):
+                return .failure(error)
+        }
+    }
+
+    if tokens.isEmpty {
+        return .failure("ERROR: Argument '<app-name>' is mandatory")
+    }
+
+    var raw = NewWindowOrOpenCmdArgs(rawArgs: args)
+    raw.launchTokens = .initialized(tokens)
+    raw.postOpenAction = postOpenAction
+    return .cmd(raw)
+}

