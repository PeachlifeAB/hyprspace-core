+        case position(PositionCmdArgs.Placement)
+    }
 
     /*conforms*/ public var windowId: UInt32?
     /*conforms*/ public var workspaceName: WorkspaceName?
     public var appName: Lateinit<String> = .uninitialized
+    public var postOpenAction: PostOpenAction? = nil
 }
+
+private func parsePostOpenAction(i: ArgParserInput) -> ParsedCliArgs<NewWindowOrOpenCmdArgs.PostOpenAction?> {
+    guard i.arg == "position" else {
+        return .fail("Unknown post-open action '\(i.arg)'. Expected 'position'", advanceBy: 1)
+    }
+    guard let rawPlacement = i.getOrNil(relativeIndex: 1) else {
+        return .fail("<preset> is mandatory after 'position'", advanceBy: 1)
+    }
+    switch parseEnum(rawPlacement, PositionCmdArgs.Placement.self) {
+        case .success(let placement):
+            return .succ(.position(placement), advanceBy: 2)
+        case .failure(let error):
+            return .fail(error, advanceBy: 2)
+    }
+}

