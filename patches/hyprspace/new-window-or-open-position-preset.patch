new file mode 100644
--- /dev/null
+++ b/Sources/AppBundle/command/impl/NewWindowOrOpenFlow.swift
@@ -0,0 +1,379 @@
+import AppKit
+import Common
+import Foundation
+
+/// Normalized application launch request: the app name plus the effective
+/// application arguments (after consuming `/usr/bin/open`'s `--args` delimiter).
+struct ApplicationLaunch: Equatable, Sendable {
+    let appName: String
+    let applicationArguments: [String]
+
+    /// `/usr/bin/open` argv for this request.
+    func openArguments(newInstance: Bool) -> [String] {
+        var result = [newInstance ? "-na" : "-a", appName]
+        if !applicationArguments.isEmpty {
+            result.append("--args")
+            result.append(contentsOf: applicationArguments)
+        }
+        return result
+    }
+}
+
+/// Identity of a running application instance: app name plus the exact ordered
+/// effective application arguments. Two instances of the same application with
+/// different arguments are distinct profiles.
+struct ApplicationInstanceProfile: Hashable, Sendable {
+    let appName: String
+    let applicationArguments: [String]
+
+    static func == (lhs: Self, rhs: Self) -> Bool {
+        lhs.appName == rhs.appName && lhs.applicationArguments == rhs.applicationArguments
+    }
+
+    func hash(into hasher: inout Hasher) {
+        hasher.combine(appName)
+        hasher.combine(applicationArguments)
+    }
+}
+
+/// Process-local registry of Hyprspace-launched application instances, keyed by
+/// argument profile. Tracks which PID belongs to which argument profile so that
+/// a repeat request reuses the exact instance, while a different profile opens
+/// a separate instance via `open -na`.
+@MainActor
+final class LaunchProfileRegistry {
+    static let shared = LaunchProfileRegistry()
+    private var entries: [ApplicationInstanceProfile: pid_t] = [:]
+
+    /// Remove entries whose process has terminated.
+    func prune() {
+        entries = entries.filter { _, pid in isAlive(pid) }
+    }
+
+    func pid(for profile: ApplicationInstanceProfile) -> pid_t? {
+        guard let pid = entries[profile] else { return nil }
+        return isAlive(pid) ? pid : nil
+    }
+
+    private func isAlive(_ pid: pid_t) -> Bool {
+        kill(pid, 0) == 0
+    }
+
+    func register(_ profile: ApplicationInstanceProfile, pid: pid_t) {
+        entries[profile] = pid
+    }
+
+    /// Test-only: remove all entries.
+    func reset() {
+        entries.removeAll()
+    }
+}
+
+/// Normalize raw launch tokens (which may contain a quoted combined invocation
+/// such as `"Helium --args --profile-directory=Default"`) into an app name and
+/// effective application arguments. Re-lexes each token with the shell lexer to
+/// split embedded words, rejecting shell operators.
+func normalizeLaunch(tokens: [String]) -> ResOrStr<ApplicationLaunch> {
+    Result { () throws(String) in
+        var words: [String] = []
+        for token in tokens {
+            // A token that contains a space alongside a dash-prefixed word is a
+            // quoted combined invocation (e.g. "Helium --args --profile=Default")
+            // and must be re-lexed into flat words. Plain tokens — including
+            // separately-quoted values with spaces like "/tmp/Profile 1" — are
+            // kept verbatim so their boundaries are preserved.
+            let isCombinedInvocation = token.contains(" ")
+                && token.split(separator: " ").contains { $0.hasPrefix("-") }
+            if isCombinedInvocation {
+                switch token.shellLexerTokens() {
+                    case .success(let lexerTokens):
+                        for lt in lexerTokens {
+                            switch lt.payload {
+                                case .word(let w): words.append(w)
+                                case .end: break
+                                default: throw "Application invocation contains a shell operator '\(lt.payload)'. Only plain words are allowed."
+                            }
+                        }
+                    case .failure(let error):
+                        throw error
+                }
+            } else {
+                words.append(token)
+            }
+        }
+        guard !words.isEmpty else {
+            throw "ERROR: Argument '<app-name>' is mandatory"
+        }
+        guard let boundaryIdx = words.firstIndex(where: { $0.isCliDashFlag }) else {
+            return ApplicationLaunch(appName: words.joined(separator: " "), applicationArguments: [])
+        }
+        let appName = words[..<boundaryIdx].joined(separator: " ")
+        var launchTail = Array(words[boundaryIdx...])
+        // Consume `/usr/bin/open`'s leading `--args` delimiter; it is not part
+        // of the effective application argument profile.
+        if launchTail.first == "--args" {
+            launchTail.removeFirst()
+        }
+        return ApplicationLaunch(appName: appName, applicationArguments: launchTail)
+    }
+}
+
+enum NewWindowOrOpenFlow {
+    /// Routing decision result: whether the action succeeded, the target PID
+    /// whose new window should be resolved, and the window-ID snapshot taken
+    /// before the action.
+    struct RouteResult: Sendable {
+        let success: Bool
+        let targetPid: pid_t?
+        let previousWindowIds: Set<UInt32>
+    }
+
+    @MainActor
+    static func perform(launch: ApplicationLaunch, io: CmdIo) async throws -> Bool {
+        try await route(launch: launch, io: io).success
+    }
+
+    @MainActor
+    static func performAndResolveWindowId(launch: ApplicationLaunch, io: CmdIo) async throws -> UInt32? {
+        let result = try await route(launch: launch, io: io)
+        guard result.success else { return nil }
+        if let pid = result.targetPid,
+           let windowId = try await waitForNewWindowId(forPid: pid, previousWindowIds: result.previousWindowIds)
+        {
+            return windowId
+        }
+        // Fallback for launch paths where the new PID could not be identified.
+        if let windowId = try await waitForNewFocusedWindowId(previousWindowIds: result.previousWindowIds) {
+            return windowId
+        }
+        _ = io.err("Failed to identify the newly opened window for '\(launch.appName)'")
+        return nil
+    }
+
+    @MainActor
+    private static func route(launch: ApplicationLaunch, io: CmdIo) async throws -> RouteResult {
+        let profile = ApplicationInstanceProfile(appName: launch.appName, applicationArguments: launch.applicationArguments)
+        LaunchProfileRegistry.shared.prune()
+
+        // 1. Exact tracked live profile: target that PID and try its new-window menu.
+        if let exactPid = LaunchProfileRegistry.shared.pid(for: profile),
+           let app = NSRunningApplication(processIdentifier: exactPid)
+        {
+            let prev = try await knownWindowIds(forPid: exactPid)
+            if try await triggerNewWindow(for: app, io: io) {
+                return RouteResult(success: true, targetPid: exactPid, previousWindowIds: prev)
+            }
+            // No usable new-window menu: fall back to another instance of the same profile.
+            return await launchAndRegister(launch: launch, profile: profile, newInstance: true, previousWindowIds: prev, io: io)
+        }
+
+        // 2. Application is running (tracked under a different profile, or untracked).
+        let runningApps = runningApplications(named: launch.appName)
+        if let app = runningApps.first {
+            if launch.applicationArguments.isEmpty {
+                // Empty arguments: try the existing instance's menu, then fall back.
+                let prev = try await knownWindowIds(forPid: app.processIdentifier)
+                if try await triggerNewWindow(for: app, io: io) {
+                    return RouteResult(success: true, targetPid: app.processIdentifier, previousWindowIds: prev)
+                }
+                return await launchAndRegister(launch: launch, profile: profile, newInstance: true, previousWindowIds: prev, io: io)
+            } else {
+                // Different argument profile (or untracked with arguments): open a new instance.
+                let prev = try await allAliveWindowIds()
+                return await launchAndRegister(launch: launch, profile: profile, newInstance: true, previousWindowIds: prev, io: io)
+            }
+        }
+
+        // 3. No matching application process: launch the first instance.
+        let prev = try await allAliveWindowIds()
+        return await launchAndRegister(launch: launch, profile: profile, newInstance: false, previousWindowIds: prev, io: io)
+    }
+
+    private static func runningApplications(named appName: String) -> [NSRunningApplication] {
+        let candidateNames = normalizedApplicationNames(from: appName)
+        return NSWorkspace.shared.runningApplications.filter { app in
+            if let localizedName = app.localizedName?.lowercased(), candidateNames.contains(localizedName) {
+                return true
+            }
+            if let bundleIdentifier = app.bundleIdentifier?.lowercased(), candidateNames.contains(bundleIdentifier) {
+                return true
+            }
+            return false
+        }
+    }
+
+    private static func normalizedApplicationNames(from appName: String) -> Set<String> {
+        let loweredAppName = appName.lowercased()
+        var candidateNames: Set<String> = [loweredAppName]
+        if loweredAppName.hasSuffix(".app") {
+            candidateNames.insert(String(loweredAppName.dropLast(4)))
+        }
+        return candidateNames
+    }
+
+    @MainActor
+    private static func triggerNewWindow(for app: NSRunningApplication, io: CmdIo) async throws -> Bool {
+        let callerWorkspace = focus.workspace
+        let previousWindowIds = try await knownWindowIds(forPid: app.processIdentifier)
+
+        guard let leaves = await activateAppAndCollectMenuLeaves(for: app, io: io) else {
+            return false
+        }
+
+        guard let leaf = selectNewWindowLeaf(from: leaves, appName: app.localizedName ?? "") else {
+            io.err("No matching new-window menu item found for '\(app.localizedName ?? app.bundleIdentifier ?? "Unknown app")'")
+            return false
+        }
+        AXUIElementPerformAction(leaf.element, kAXPressAction as CFString)
+        guard let newWindowId = try await waitForNewWindowId(forPid: app.processIdentifier, previousWindowIds: previousWindowIds),
+              let newWindow = Window.get(byId: newWindowId)
+        else {
+            _ = callerWorkspace.focusWorkspace()
+            return true
+        }
+
+        if newWindow.nodeWorkspace != callerWorkspace {
+            _ = moveWindowToWorkspace(newWindow, callerWorkspace, io, focusFollowsWindow: true, failIfNoop: false)
+        } else {
+            _ = callerWorkspace.focusWorkspace()
+        }
+        return true
+    }
+
+    @MainActor
+    private static func launchAndRegister(
+        launch: ApplicationLaunch,
+        profile: ApplicationInstanceProfile,
+        newInstance: Bool,
+        previousWindowIds: Set<UInt32>,
+        io: CmdIo,
+    ) async -> RouteResult {
+        let previousPids = Set(runningApplications(named: launch.appName).map(\.processIdentifier))
+        guard launchViaOpen(launch: launch, newInstance: newInstance, io: io) else {
+            return RouteResult(success: false, targetPid: nil, previousWindowIds: previousWindowIds)
+        }
+        let newApp = await waitForNewRunningApplication(named: launch.appName, previousPids: previousPids)
+        if let newApp {
+            LaunchProfileRegistry.shared.register(profile, pid: newApp.processIdentifier)
+        }
+        return RouteResult(success: true, targetPid: newApp?.processIdentifier, previousWindowIds: previousWindowIds)
+    }
+
+    private static func launchViaOpen(launch: ApplicationLaunch, newInstance: Bool, io: CmdIo) -> Bool {
+        let process = Process()
+        process.executableURL = URL(filePath: "/usr/bin/open")
+        process.arguments = launch.openArguments(newInstance: newInstance)
+
+        do {
+            try process.run()
+            process.waitUntilExit()
+            guard process.terminationReason == .exit && process.terminationStatus == 0 else {
+                io.err("Failed to open application '\(launch.appName)': open exited with status \(process.terminationStatus) and reason \(process.terminationReason.rawValue)")
+                return false
+            }
+            return true
+        } catch {
+            io.err("Failed to open application '\(launch.appName)': \(error.localizedDescription)")
+            return false
+        }
+    }
+
+    @MainActor
+    private static func waitForNewRunningApplication(named appName: String, previousPids: Set<pid_t>) async -> NSRunningApplication? {
+        let candidates = normalizedApplicationNames(from: appName)
+        for _ in 0 ..< 40 {
+            try? await Task.sleep(nanoseconds: 100_000_000)
+            let current = NSWorkspace.shared.runningApplications.filter { app in
+                if let name = app.localizedName?.lowercased(), candidates.contains(name) { return true }
+                if let bid = app.bundleIdentifier?.lowercased(), candidates.contains(bid) { return true }
+                return false
+            }
+            let newApps = current.filter { !previousPids.contains($0.processIdentifier) }
+            if let app = newApps.singleOrNil() {
+                return app
+            }
+        }
+        return nil
+    }
+
+    @MainActor
+    private static func knownWindowIds(forPid pid: pid_t) async throws -> Set<UInt32> {
+        try await aliveWindowIdsByPid()[pid] ?? []
+    }
+
+    @MainActor
+    private static func allAliveWindowIds() async throws -> Set<UInt32> {
+        Set(try await aliveWindowIdsByPid().values.flatMap { $0 })
+    }
+
+    @MainActor
+    private static func aliveWindowIdsByPid() async throws -> [pid_t: Set<UInt32>] {
+        let mapping = try await MacApp.refreshAllAndGetAliveWindowIds(frontmostAppBundleId: NSWorkspace.shared.frontmostApplication?.bundleIdentifier)
+        var result: [pid_t: Set<UInt32>] = [:]
+        for (app, windowIds) in mapping {
+            for windowId in windowIds {
+                _ = try await MacWindow.getOrRegister(windowId: windowId, macApp: app)
+            }
+            result[app.pid] = Set(windowIds)
+        }
+        return result
+    }
+
+    @MainActor
+    private static func waitForNewWindowId(forPid pid: pid_t, previousWindowIds: Set<UInt32>) async throws -> UInt32? {
+        for _ in 0 ..< 40 {
+            try await Task.sleep(nanoseconds: 100_000_000)
+
+            let newWindowIds = try await knownWindowIds(forPid: pid).subtracting(previousWindowIds)
+            if let windowId = newWindowIds.singleOrNil() {
+                return windowId
+            }
+            if let focusedWindow = focus.windowOrNil,
+               newWindowIds.contains(focusedWindow.windowId),
+               focusedWindow.app.pid == pid
+            {
+                return focusedWindow.windowId
+            }
+        }
+        return nil
+    }
+
+    @MainActor
+    private static func waitForNewFocusedWindowId(previousWindowIds: Set<UInt32>) async throws -> UInt32? {
+        for _ in 0 ..< 40 {
+            try await Task.sleep(nanoseconds: 100_000_000)
+
+            let newWindowIds = try await allAliveWindowIds().subtracting(previousWindowIds)
+            if let focusedWindow = focus.windowOrNil, newWindowIds.contains(focusedWindow.windowId) {
+                return focusedWindow.windowId
+            }
+            if let windowId = newWindowIds.singleOrNil() {
+                return windowId
+            }
+        }
+        return nil
+    }
+}
+
+func selectNewWindowLeaf(from leaves: [AppMenuLeaf], appName: String) -> AppMenuLeaf? {
+    let loweredAppName = appName.lowercased()
+    let preferredLeaves = ["new \(loweredAppName) window"]
+
+    for preferredLeaf in preferredLeaves {
+        if let match = leaves.first(where: { $0.leaf.lowercased() == preferredLeaf }) {
+            return match
+        }
+    }
+
+    if let genericNewWindow = leaves.first(where: {
+        let loweredLeaf = $0.leaf.lowercased()
+        return loweredLeaf.hasPrefix("new window")
+    }) {
+        return genericNewWindow
+    }
+
+    return leaves.first(where: {
+        let loweredLeaf = $0.leaf.lowercased()
+        return $0.fullPath.lowercased().hasPrefix("file / new") && loweredLeaf.contains("window")
+    })
+}

