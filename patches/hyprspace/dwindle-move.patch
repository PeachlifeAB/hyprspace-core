+import AppKit
+import Common
+
+/// Hyprland-style dwindle `move`: take the point just past the window's edge in `direction`, pull the window out of
+/// the tree and reinsert it by splitting whichever window covers that point once the window's slot has collapsed.
+/// The split follows the target's aspect ratio and the window takes the half the point falls in, so the tree stays
+/// a binary dwindle instead of growing extra columns the way i3-style `move` does.
+///
+/// Returns `false`, leaving the tree untouched, when the move has no window to split in that direction (workspace
+/// edge, accordion containers, or no layout yet), so the caller can fall back to the regular `move` behavior.
+@MainActor
+func dwindleMove(_ window: Window, _ direction: CardinalDirection) -> Bool {
+    guard let parent = window.parent as? TilingContainer,
+          let workspace = window.nodeWorkspace,
+          let windowRect = window.lastAppliedLayoutVirtualRect,
+          let parentRect = parent.lastAppliedLayoutVirtualRect,
+          window.isInTilesOnlyBranch
+    else { return false }
+
+    let focal = dwindleFocalPoint(of: windowRect, direction)
+    let candidates = workspace.rootTilingContainer.allLeafWindowsRecursive.lazy
+        .filter { $0 != window && $0.isInTilesOnlyBranch }
+        .compactMap { candidate -> (Window, Rect)? in
+            guard let rect = candidate.lastAppliedLayoutVirtualRect else { return nil }
+            let collapsed = candidate.parents.contains(where: { $0 === parent })
+                ? collapse(rect, removing: windowRect, from: parentRect, along: parent.orientation)
+                : rect
+            return (candidate, collapsed)
+        }
+    guard let (target, targetRect) = candidates.first(where: { $0.1.contains(focal) }) else { return false }
+
+    window.unbindFromParent()
+    guard let targetParent = target.parent as? TilingContainer, let targetIndex = target.ownIndex else {
+        window.bind(to: workspace.rootTilingContainer, adaptiveWeight: WEIGHT_AUTO, index: INDEX_BIND_LAST)
+        return true
+    }
+    switch mouseDropPlacement(
+        targetRect: targetRect,
+        targetIndex: targetIndex,
+        parentOrientation: targetParent.orientation,
+        drop: focal,
+    ) {
+        case .sibling(let index):
+            window.bind(to: targetParent, adaptiveWeight: WEIGHT_AUTO, index: index)
+        case .split(let orientation, let index):
+            let splitContainer = TilingContainer(
+                parent: targetParent,
+                adaptiveWeight: target.getWeight(targetParent.orientation),
+                orientation,
+                .tiles,
+                index: targetIndex,
+            )
+            target.bind(to: splitContainer, adaptiveWeight: WEIGHT_AUTO, index: 0)
+            window.bind(to: splitContainer, adaptiveWeight: WEIGHT_AUTO, index: index)
+    }
+    return true
+}
+
+/// The point one pixel past the middle of the window's edge in `direction`.
+func dwindleFocalPoint(of rect: Rect, _ direction: CardinalDirection) -> CGPoint {
+    switch direction {
+        case .left: CGPoint(x: rect.minX - 1, y: rect.center.y)
+        case .right: CGPoint(x: rect.maxX + 1, y: rect.center.y)
+        case .up: CGPoint(x: rect.center.x, y: rect.minY - 1)
+        case .down: CGPoint(x: rect.center.x, y: rect.maxY + 1)
+    }
+}
+
+/// Where `rect`, inside `container`, ends up once `removed` (a child slot of `container`) is taken out and the rest
+/// of `container` stretches along `orientation` to fill the gap. Exact for binary trees, close enough for wider ones.
+func collapse(_ rect: Rect, removing removed: Rect, from container: Rect, along orientation: Orientation) -> Rect {
+    let start = orientation == .h ? container.minX : container.minY
+    let length = container.getDimension(orientation)
+    let gapStart = orientation == .h ? removed.minX : removed.minY
+    let gapLength = removed.getDimension(orientation)
+    guard length - gapLength > 0 else { return rect }
+    let scale = length / (length - gapLength)
+    func map(_ x: CGFloat) -> CGFloat {
+        let kept = x <= gapStart ? x - start : max(x - gapLength, gapStart) - start
+        return start + kept * scale
+    }
+    switch orientation {
+        case .h:
+            let minX = map(rect.minX), maxX = map(rect.maxX)
+            return Rect(topLeftX: minX, topLeftY: rect.minY, width: maxX - minX, height: rect.height)
+        case .v:
+            let minY = map(rect.minY), maxY = map(rect.maxY)
+            return Rect(topLeftX: rect.minX, topLeftY: minY, width: rect.width, height: maxY - minY)
+    }
+}
+
+extension Window {
+    /// Accordion children overlap, so their layout rects say nothing about what is next to what.
+    @MainActor
+    fileprivate var isInTilesOnlyBranch: Bool {
+        parents.allSatisfy { ($0 as? TilingContainer)?.layout != .accordion }
+    }
+}

