+@testable import AppBundle
+import Common
+import XCTest
+
+@MainActor
+final class DwindleMoveTest: XCTestCase {
+    override func setUp() async throws {
+        setUpWorkspacesForTests()
+        config.enableNormalizationFlattenContainers = true
+        config.enableNormalizationOppositeOrientationForNestedContainers = true
+    }
+
+    /// H[1, V[2, 3]]
+    private func threeWindows() -> (Workspace, TestWindow) {
+        let workspace = Workspace.get(byName: name)
+        var focused: TestWindow!
+        workspace.rootTilingContainer.apply {
+            TestWindow.new(id: 1, parent: $0)
+            TilingContainer.newVTiles(parent: $0, adaptiveWeight: 1).apply {
+                TestWindow.new(id: 2, parent: $0)
+                focused = TestWindow.new(id: 3, parent: $0)
+            }
+        }
+        return (workspace, focused)
+    }
+
+    private func move(_ direction: String, in workspace: Workspace) async throws {
+        try await workspace.layoutWorkspace()
+        await parseCommand("move \(direction)").cmdOrDie.run(.defaultEnv, .emptyStdin)
+        workspace.normalizeContainers()
+    }
+
+    func testMoveIntoSiblingSwapsAcrossSplit() async throws {
+        let (workspace, window) = threeWindows()
+        assertTrue(window.focusWindow())
+        try await move("up", in: workspace)
+        assertEquals(workspace.rootTilingContainer.layoutDescription, .h_tiles([.window(1), .v_tiles([.window(3), .window(2)])]))
+    }
+
+    func testMoveIntoNeighbourSplitsItOnTheNearHalf() async throws {
+        let (workspace, window) = threeWindows()
+        assertTrue(window.focusWindow())
+        try await move("left", in: workspace)
+        // 3 sat in the bottom half, so it takes the bottom half of 1; 2 fills the column 3 left behind.
+        assertEquals(workspace.rootTilingContainer.layoutDescription, .h_tiles([.v_tiles([.window(1), .window(3)]), .window(2)]))
+    }
+
+    func testMoveKeepsTreeBinaryInsteadOfAddingColumns() async throws {
+        let workspace = Workspace.get(byName: name)
+        var window3: TestWindow!
+        workspace.rootTilingContainer.apply {
+            TestWindow.new(id: 1, parent: $0)
+            TilingContainer.newVTiles(parent: $0, adaptiveWeight: 1).apply {
+                TestWindow.new(id: 2, parent: $0)
+                TilingContainer.newHTiles(parent: $0, adaptiveWeight: 1).apply {
+                    window3 = TestWindow.new(id: 3, parent: $0)
+                    TestWindow.new(id: 4, parent: $0)
+                }
+            }
+        }
+        assertTrue(window3.focusWindow())
+        try await move("left", in: workspace)
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([.v_tiles([.window(1), .window(3)]), .v_tiles([.window(2), .window(4)])]),
+        )
+    }
+
+    func testMoveAtWorkspaceEdgeFallsBackToRegularMove() async throws {
+        let workspace = Workspace.get(byName: name)
+        workspace.rootTilingContainer.apply {
+            TestWindow.new(id: 1, parent: $0)
+            assertTrue(TestWindow.new(id: 2, parent: $0).focusWindow())
+        }
+        try await move("right", in: workspace)
+        assertEquals(workspace.rootTilingContainer.layoutDescription, .h_tiles([.window(1), .window(2)]))
+        try await move("left", in: workspace)
+        assertEquals(workspace.rootTilingContainer.layoutDescription, .h_tiles([.window(2), .window(1)]))
+    }
+
+    func testMoveTowardLoneSiblingSwapsEvenWhenItIsWider() async throws {
+        let workspace = Workspace.get(byName: name)
+        var window2: TestWindow!
+        workspace.rootTilingContainer.apply {
+            TestWindow.new(id: 1, parent: $0, adaptiveWeight: 1344)
+            window2 = TestWindow.new(id: 2, parent: $0, adaptiveWeight: 576)
+        }
+        assertTrue(window2.focusWindow())
+        try await move("left", in: workspace)
+        assertEquals(workspace.rootTilingContainer.layoutDescription, .h_tiles([.window(2), .window(1)]))
+    }
+
+    func testMoveNeverAddsAThirdChild() async throws {
+        let workspace = Workspace.get(byName: name)
+        var window3: TestWindow!
+        workspace.rootTilingContainer.apply {
+            TestWindow.new(id: 1, parent: $0, adaptiveWeight: 1344)
+            TilingContainer.newVTiles(parent: $0, adaptiveWeight: 576).apply {
+                TestWindow.new(id: 2, parent: $0)
+                window3 = TestWindow.new(id: 3, parent: $0)
+            }
+        }
+        assertTrue(window3.focusWindow())
+        try await move("left", in: workspace)
+        // 1 is still wider than tall, so it splits side by side; the nested split keeps 1's direction.
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([.h_tiles([.window(1), .window(3)]), .window(2)]),
+        )
+    }
+
+    /// Each step was traced through Hyprland's `moveTargetInDirection` on the same 1920x1080 tree.
+    func testMovesFiveLayersDeepMatchHyprland() async throws {
+        let workspace = Workspace.get(byName: name)
+        var windows: [UInt32: TestWindow] = [:]
+        workspace.rootTilingContainer.apply {
+            windows[1] = TestWindow.new(id: 1, parent: $0)
+            TilingContainer.newVTiles(parent: $0, adaptiveWeight: 1).apply {
+                windows[2] = TestWindow.new(id: 2, parent: $0)
+                TilingContainer.newHTiles(parent: $0, adaptiveWeight: 1).apply {
+                    windows[3] = TestWindow.new(id: 3, parent: $0)
+                    TilingContainer.newVTiles(parent: $0, adaptiveWeight: 1).apply {
+                        windows[4] = TestWindow.new(id: 4, parent: $0)
+                        windows[5] = TestWindow.new(id: 5, parent: $0)
+                    }
+                }
+            }
+        }
+        func move(_ id: UInt32, _ direction: String) async throws {
+            assertTrue(windows[id]!.focusWindow())
+            try await self.move(direction, in: workspace)
+        }
+
+        try await move(5, "left") // splits 3, landing in its lower half
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([.window(1), .v_tiles([.window(2), .h_tiles([.v_tiles([.window(3), .window(5)]), .window(4)])])]),
+        )
+        try await move(5, "up") // lone sibling: swap
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([.window(1), .v_tiles([.window(2), .h_tiles([.v_tiles([.window(5), .window(3)]), .window(4)])])]),
+        )
+        try await move(5, "up") // out of its split, into the left half of 2
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([.window(1), .v_tiles([.h_tiles([.window(5), .window(2)]), .h_tiles([.window(3), .window(4)])])]),
+        )
+        try await move(1, "right") // the right column becomes the whole screen, so every split below it turns
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([.v_tiles([.window(5), .window(2)]), .v_tiles([.window(3), .h_tiles([.window(1), .window(4)])])]),
+        )
+        try await move(4, "left") // lone sibling: swap
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([.v_tiles([.window(5), .window(2)]), .v_tiles([.window(3), .h_tiles([.window(4), .window(1)])])]),
+        )
+    }
+
+    func testRandomMovesKeepTheTreeABinaryDwindle() async throws {
+        let workspace = Workspace.get(byName: name)
+        var rng = SplitMix64(seed: 0x5EED)
+        var windows: [TestWindow] = []
+        for id in 1 ... 7 {
+            windows.randomElement(using: &rng)?.markAsMostRecentChild()
+            let window = TestWindow.new(id: UInt32(id), parent: macosPopupWindowsContainer)
+            try await window.relayoutWindow(on: workspace, .nonCancellable, forceTile: true)
+            windows.append(window)
+            workspace.normalizeContainers()
+        }
+        for step in 0 ..< 300 {
+            let window = windows.randomElement(using: &rng)!
+            let direction = CardinalDirection.allCases.randomElement(using: &rng)!
+            assertTrue(window.focusWindow())
+            try await move(direction.rawValue, in: workspace)
+            try await workspace.layoutWorkspace()
+            let context = "step \(step): move \(window.windowId) \(direction) -> \(workspace.rootTilingContainer.layoutDescription)"
+            assertEquals(workspace.rootTilingContainer.allLeafWindowsRecursive.map(\.windowId).sorted(), Array(1 ... 7), additionalMsg: context)
+            assertDwindleShape(workspace.rootTilingContainer, context)
+        }
+    }
+
+    private func assertDwindleShape(_ container: TilingContainer, _ context: String) {
+        if container.isRootContainer {
+            assertTrue(container.children.count == 2 || container.children.singleOrNil() is Window)
+        } else {
+            assertEquals(container.children.count, 2, additionalMsg: context)
+        }
+        let rect = container.lastAppliedLayoutVirtualRect!
+        assertEquals(container.orientation, rect.width >= rect.height ? .h : .v, additionalMsg: "\(context) at \(rect)")
+        for child in container.children {
+            (child as? TilingContainer).map { assertDwindleShape($0, context) }
+        }
+    }
+
+    func testFocalPointIsJustPastTheEdge() {
+        let rect = Rect(topLeftX: 100, topLeftY: 100, width: 200, height: 100)
+        assertEquals(dwindleFocalPoint(of: rect, .left), CGPoint(x: 99, y: 150))
+        assertEquals(dwindleFocalPoint(of: rect, .right), CGPoint(x: 301, y: 150))
+        assertEquals(dwindleFocalPoint(of: rect, .up), CGPoint(x: 200, y: 99))
+        assertEquals(dwindleFocalPoint(of: rect, .down), CGPoint(x: 200, y: 201))
+    }
+}
+
+/// Seeded, so a failing random sequence replays the same way.
+private struct SplitMix64: RandomNumberGenerator {
+    var state: UInt64
+    init(seed: UInt64) { state = seed }
+    mutating func next() -> UInt64 {
+        state &+= 0x9E37_79B9_7F4A_7C15
+        var z = state
+        z = (z ^ (z >> 30)) &* 0xBF58_476D_1CE4_E5B9
+        z = (z ^ (z >> 27)) &* 0x94D0_49BB_1331_11EB
+        return z ^ (z >> 31)
+    }
+}

