+import AppKit
+import Common
+
+/// Hyprland-style dwindle `move`, after `CDwindleAlgorithm::moveTargetInDirection`: aim at the point just past the
+/// window's edge in `direction`. Moving straight at a lone sibling window swaps the two. Otherwise the window leaves
+/// the tree (its sibling takes over the split), the remaining splits re-orient to their new boxes, and the window
+/// splits whichever leaf now lies at that point, taking the half the point falls in. The tree stays binary.
+///
+/// Returns `false`, leaving the tree untouched, when the point is past the workspace edge, the window sits in an
+/// accordion stack or hasn't been laid out yet, so the caller can fall back to the regular `move` (boundaries,
+/// monitors, accordion order).
+@MainActor
+func dwindleMove(_ window: Window, _ direction: CardinalDirection) -> Bool {
+    guard let parent = window.parent as? TilingContainer,
+          let workspace = window.nodeWorkspace,
+          window.lastAppliedLayoutVirtualRect != nil,
+          let windowRect = workspace.dwindleLeafRects().first(where: { $0.0 === window })?.1
+    else { return false }
+    let focal = dwindleFocalPoint(of: windowRect, direction)
+    guard workspace.dwindleRect.contains(focal) else { return false }
+
+    if parent.children.count == 2, parent.orientation == direction.orientation,
+       let index = window.ownIndex, index == (direction.isPositive ? 0 : 1),
+       parent.children[1 - index] is Window
+    {
+        window.unbindFromParent()
+        window.bind(to: parent, adaptiveWeight: WEIGHT_AUTO, index: 1 - index)
+        return true
+    }
+
+    window.unbindFromParent()
+    parent.promoteLoneChild()
+    workspace.normalizeDwindleTree()
+    let leaves = workspace.dwindleLeafRects()
+    guard let target = leaves.first(where: { $0.1.contains(focal) })
+        ?? leaves.min(by: { distanceSquared(focal, $0.1) < distanceSquared(focal, $1.1) })
+    else {
+        window.bind(to: workspace.rootTilingContainer, adaptiveWeight: WEIGHT_AUTO, index: INDEX_BIND_LAST)
+        return true
+    }
+    let binding = dwindleSplit(target.0, at: target.1, toward: focal)
+    window.bind(to: binding.parent, adaptiveWeight: binding.adaptiveWeight, index: binding.index)
+    return true
+}
+
+/// The point one pixel past the middle of the window's edge in `direction`.
+func dwindleFocalPoint(of rect: Rect, _ direction: CardinalDirection) -> CGPoint {
+    switch direction {
+        case .left: CGPoint(x: rect.minX - 1, y: rect.center.y)
+        case .right: CGPoint(x: rect.maxX + 1, y: rect.center.y)
+        case .up: CGPoint(x: rect.center.x, y: rect.minY - 1)
+        case .down: CGPoint(x: rect.center.x, y: rect.maxY + 1)
+    }
+}
+
+/// Hyprland's `getClosestNode` metric: zero inside the rect, squared distance to its nearest edge outside.
+private func distanceSquared(_ point: CGPoint, _ rect: Rect) -> CGFloat {
+    let dx = max(rect.minX - point.x, 0, point.x - rect.maxX)
+    let dy = max(rect.minY - point.y, 0, point.y - rect.maxY)
+    return dx * dx + dy * dy
+}

