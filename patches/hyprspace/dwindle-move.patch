@@ -0,0 +1,127 @@
+@testable import AppBundle
+import Common
+import XCTest
+
+/// Hyprland's own dwindle integration tests (`hyprtester/src/tests/main/dwindle.cpp`), ported case by case.
+///
+/// Hyprland asserts pixel positions with `gaps_out = 20`, `gaps_in = 5` and 2px borders. These layouts have no gaps,
+/// so `at: 967,547 size: 931,511` (the bottom-right quarter of 1920x1080) becomes `[960, 540, 960, 540]`. Full-height
+/// windows are 1079 tall: `layoutWorkspace` lays out at `height - 1`.
+/// The tester runs with `preserve_split = true`. Only `togglesplit` depends on that here, and sticky flips keep a
+/// toggled split the same way. Cases built on commands AeroSpace doesn't have (`splitratio`, `rotatesplit`, groups,
+/// fullscreen modes, floating clamps) aren't ported.
+@MainActor
+final class HyprlandDwindleTest: XCTestCase {
+    override func setUp() async throws {
+        setUpWorkspacesForTests()
+        config.enableNormalizationFlattenContainers = true
+        config.enableNormalizationOppositeOrientationForNestedContainers = true
+    }
+
+    /// `dwindleIssue13349`: moving a window uses a focal point just past its edge to pick where it lands.
+    func testDwindleIssue13349() async throws {
+        let workspace = Workspace.get(byName: name)
+        try await spawn(1, on: workspace)
+        try await spawn(2, on: workspace)
+        let c = try await spawn(3, on: workspace)
+        assertEquals(rect(c), [960, 540, 960, 540])
+
+        try await run("move left", on: workspace)
+        assertEquals(rect(c), [0, 540, 960, 540])
+
+        try await run("move right", on: workspace)
+        assertEquals(rect(c), [960, 540, 960, 540])
+    }
+
+    /// `dwindleSplit`, its `togglesplit` and `swapsplit` steps (AeroSpace's `layout tiles horizontal vertical` and
+    /// `swap`). The `splitratio` steps have no AeroSpace equivalent.
+    func testDwindleSplit() async throws {
+        let workspace = Workspace.get(byName: name)
+        let a = try await spawn(1, on: workspace)
+        try await spawn(2, on: workspace)
+        assertTrue(a.focusWindow())
+        assertEquals(rect(a), [0, 0, 960, 1079])
+
+        try await run("layout tiles horizontal vertical", on: workspace)
+        assertEquals(rect(a), [0, 0, 1920, 540])
+
+        try await run("swap down", on: workspace)
+        assertEquals(rect(a), [0, 540, 1920, 540])
+    }
+
+    /// `dwindleForceSplitOnMoveToWorkspace`: a window sent to a workspace splits the window already there and, with
+    /// `force_split = 2` (what dwindle insertion here always does), takes the right half.
+    func testDwindleForceSplitOnMoveToWorkspace() async throws {
+        let target = Workspace.get(byName: "hyprland-target")
+        try await spawn(1, on: target)
+        let workspace = Workspace.get(byName: name)
+        let window = try await spawn(2, on: workspace)
+        let before = rect(window)
+
+        try await run("move-node-to-workspace \(target.name)", on: workspace)
+        try await settle(target)
+        assertEquals(target.rootTilingContainer.layoutDescription, .h_tiles([.window(1), .window(2)]))
+        assertEquals(rect(window), [960, 0, 960, 1079])
+        assertTrue(rect(window) != before)
+    }
+
+    /// `dwindleMoveAcrossToggledSplit`: moving across a split whose orientation was toggled against its box must not
+    /// revert it; the window trades places with its sibling.
+    func testDwindleMoveAcrossToggledSplit() async throws {
+        let workspace = Workspace.get(byName: name)
+        let a = try await spawn(1, on: workspace)
+        let b = try await spawn(2, on: workspace)
+        try await run("layout tiles horizontal vertical", on: workspace)
+        let bBefore = rect(b)
+        assertEquals(bBefore, [0, 540, 1920, 540])
+
+        assertTrue(a.focusWindow())
+        try await run("move down", on: workspace)
+        assertEquals(rect(a), bBefore)
+    }
+
+    /// `dwindleMoveSmallWindowAcrossSplit`: a window under half its split (there via `force_split = 1` and
+    /// `default_split_ratio = 1.2` with `split_bias`) still moves across it.
+    func testDwindleMoveSmallWindowAcrossSplit() async throws {
+        let workspace = Workspace.get(byName: name)
+        var b: TestWindow!
+        workspace.rootTilingContainer.apply {
+            b = TestWindow.new(id: 2, parent: $0, adaptiveWeight: 768)
+            TestWindow.new(id: 1, parent: $0, adaptiveWeight: 1152)
+        }
+        assertTrue(b.focusWindow())
+        try await settle(workspace)
+        let before = rect(b)
+        assertEquals(before, [0, 0, 768, 1079])
+
+        try await run("move right", on: workspace)
+        assertTrue(rect(b) != before)
+        assertEquals(workspace.rootTilingContainer.layoutDescription, .h_tiles([.window(1), .window(2)]))
+    }
+
+    /// Hyprland's `SPAWN_KITTY`: a new tiled window, focused.
+    @discardableResult
+    private func spawn(_ id: UInt32, on workspace: Workspace) async throws -> TestWindow {
+        let window = TestWindow.new(id: id, parent: macosPopupWindowsContainer)
+        try await window.relayoutWindow(on: workspace, .nonCancellable, forceTile: true)
+        assertTrue(window.focusWindow())
+        try await settle(workspace)
+        return window
+    }
+
+    private func run(_ command: String, on workspace: Workspace) async throws {
+        await parseCommand(command).cmdOrDie.run(.defaultEnv, .emptyStdin)
+        try await settle(workspace)
+    }
+
+    private func settle(_ workspace: Workspace) async throws {
+        workspace.normalizeContainers()
+        try await workspace.layoutWorkspace()
+    }
+
+    /// Hyprland's `at:`/`size:` pair, rounded the way its socket prints them.
+    private func rect(_ window: Window) -> [CGFloat] {
+        let rect = window.lastAppliedLayoutVirtualRect!
+        return [rect.minX, rect.minY, rect.width, rect.height].map { $0.rounded() }
+    }
+}
