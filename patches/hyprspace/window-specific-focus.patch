@@ -130,6 +131,13 @@ final class MacApp: AbstractApp {
     @MainActor func nativeFocus(_ windowId: UInt32) {
         if serverArgs.isReadOnly { return }
         MacApp.focusJob?.cancel()
+        // Focus the exact window before returning; app activation may restore another monitor's window.
+        if monitors.count > 1 && hyprspaceMakeKeyWindow(pid, windowId) {
+            MacApp.focusJob = withWindowAsync(windowId, .cancellable) { window, job in
+                AXUIElementPerformAction(window, kAXRaiseAction as CFString)
+            }
+            return
+        }
