 // This file exists purely because xcode doesn't like header only targets, SPM is fine with them
 #import "private.h"
+
+#import <Carbon/Carbon.h>
+#import <dispatch/dispatch.h>
+#import <dlfcn.h>
+#import <string.h>
+
+// WindowServer focus sequence used by Amethyst/yabai and AeroSpace PR #2179.
+// https://github.com/nikitabobko/AeroSpace/pull/2179
+bool hyprspaceMakeKeyWindow(pid_t pid, uint32_t windowId) {
+    typedef CGError (*FrontProcess)(ProcessSerialNumber *, uint32_t, uint32_t);
+    typedef CGError (*PostEvent)(ProcessSerialNumber *, uint8_t *);
+    static FrontProcess frontProcess;
+    static PostEvent postEvent;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        void *library = dlopen("/System/Library/PrivateFrameworks/SkyLight.framework/SkyLight", RTLD_LAZY | RTLD_LOCAL);
+        if (library) {
+            frontProcess = (FrontProcess)dlsym(library, "_SLPSSetFrontProcessWithOptions");
+            postEvent = (PostEvent)dlsym(library, "SLPSPostEventRecordTo");
+        }
+    });
+    if (!frontProcess || !postEvent) return false;
+    ProcessSerialNumber process;
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    if (GetProcessForPID(pid, &process) != noErr) return false;
+#pragma clang diagnostic pop
+    // kCPSUserGenerated marks this window-specific activation as user initiated.
+    if (frontProcess(&process, windowId, 0x200) != kCGErrorSuccess) return false;
+    uint8_t event[0xf8] = {0};
+    event[0x04] = 0xf8;
+    event[0x3a] = 0x10;
+    memcpy(event + 0x3c, &windowId, sizeof(windowId));
+    memset(event + 0x20, 0xff, 0x10);
+    event[0x08] = 0x01;
+    if (postEvent(&process, event) != kCGErrorSuccess) return false;
+    event[0x08] = 0x02;
+    return postEvent(&process, event) == kCGErrorSuccess;
+}
