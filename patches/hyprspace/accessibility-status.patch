--- /dev/null
+++ b/Sources/Common/util/accessibilityStatus.swift
@@ -0,0 +1,26 @@
+import Foundation
+@preconcurrency import ApplicationServices
+
+private let axTrustedCheckOptionPrompt: String = kAXTrustedCheckOptionPrompt.takeRetainedValue() as String
+
+/// Non-prompting accessibility trust check for the current process.
+/// Returns true if the process is trusted for Accessibility, false otherwise.
+/// Does NOT trigger any system prompts or dialogs.
+public func checkAccessibilityStatusNonPrompting() -> Bool {
+    let options = [axTrustedCheckOptionPrompt: false] as CFDictionary
+    return AXIsProcessTrustedWithOptions(options)
+}
+
+/// Prints machine-readable accessibility status for the current process.
+/// Output format: key=value pairs, one per line, for shell parsing.
+/// Includes: executable path, bundle identifier (if available), and trust status.
+public func printAccessibilityStatusAndExit() -> Never {
+    let isTrusted = checkAccessibilityStatusNonPrompting()
+    let executablePath = CommandLine.arguments.first ?? "unknown"
+    let bundleId = Bundle.main.bundleIdentifier ?? "none"
+
+    print("executable=\(executablePath)")
+    print("bundle_id=\(bundleId)")
+    print("trusted=\(isTrusted ? "true" : "false")")
+    exit(0)
+}
