# Summary: Changes the starter browser shortcut so alt-b opens or creates Safari instead of switching to workspace B.

diff --git a/Sources/AppBundleTests/config/ConfigTest.swift b/Sources/AppBundleTests/config/ConfigTest.swift
index 553eee65..9d705159 100644
--- a/Sources/AppBundleTests/config/ConfigTest.swift
+++ b/Sources/AppBundleTests/config/ConfigTest.swift
@@ -27,6 +27,12 @@ final class ConfigTest: XCTestCase {
         let result = parseConfig(toml)
         assertEquals(result.errors, [])
         assertEquals(result.warnings, [])
+        // Assert that the opinionated default shortcut for browser (alt-b) exists
+        let altB = result.config.modes[mainModeId]?.bindings["alt-b"]
+        assertNotNil(altB)
+        let newWindowCmd = altB?.commands.flatten().first as? NewWindowOrOpenCommand
+        assertNotNil(newWindowCmd)
+        assertEquals(newWindowCmd?.args.appName.val, "Safari")
     }
 
     func testConfigVersionOutOfBounds() {
