# Summary: Strip ANSI color escapes from grep output in generate.sh so subcommand descriptions render without escape sequences.
diff --git a/generate.sh b/generate.sh
--- a/generate.sh
+++ b/generate.sh
@@ -82,7 +82,7 @@ entries() {
             continue
         fi
         subcommand=$(basename $file | sed 's/^aerospace-//' | sed 's/\.adoc$//')
-        desc="$(grep :manpurpose: "$file" | sed -E 's/:manpurpose: //')"
+        desc="$(grep --color=never :manpurpose: "$file" | sed -E 's/:manpurpose: //')"
         echo "    [\"  $subcommand\", \"$desc\"],"
     done
 }
