new file mode 100644
--- /dev/null
+++ b/Sources/AppBundle/tree/dwindleTree.swift
@@ -0,0 +1,170 @@
+import AppKit
+import Common
+
+// Hyprland's dwindle is a strictly binary tree whose splits follow the boxes they divide: a box wider than it is tall
+// splits side by side, anything else splits top and bottom, re-decided on every layout. A split the user flips keeps
+// its flip until it goes away. AeroSpace's tree lets a container hold any number of children and stores each
+// container's orientation, so `normalizeContainers` reshapes it into that form after every command, whatever the
+// command did to it.
+
+extension Workspace {
+    /// The rect the tiling tree is laid out in, as `layoutWorkspace` sees it, down to its `height - 1`: near-square
+    /// boxes must pick the same split direction here as in the real layout.
+    @MainActor var dwindleRect: Rect {
+        let rect = workspaceMonitor.visibleRectPaddedByOuterGaps
+        return Rect(topLeftX: rect.topLeftX, topLeftY: rect.topLeftY, width: rect.width, height: rect.height - 1)
+    }
+
+    /// Each half rides on the upstream normalization it stands in for, so turning that off turns this off too.
+    @MainActor func normalizeDwindleTree() {
+        let mruWindow = mostRecentWindowRecursive
+        if config.enableNormalizationFlattenContainers && rootTilingContainer.binarize() {
+            mruWindow?.markAsMostRecentChild() // rebinding nodes reorders MRU; keep the focused branch on top
+        }
+        if config.enableNormalizationOppositeOrientationForNestedContainers {
+            _ = rootTilingContainer.pinFlippedSplits()
+            rootTilingContainer.orientSplits(in: dwindleRect)
+        }
+    }
+
+    /// Where every dwindle leaf would land if the workspace were laid out now, as if inner gaps were zero. A leaf is a
+    /// window, or a whole accordion stack: its windows overlap, so they say nothing about what is next to what.
+    @MainActor func dwindleLeafRects() -> [(TreeNode, Rect)] {
+        var result: [(TreeNode, Rect)] = []
+        func visit(_ node: TreeNode, _ rect: Rect) {
+            if let container = node as? TilingContainer, container.layout == .tiles {
+                for (child, childRect) in zip(container.children, container.dwindleChildRects(in: rect)) {
+                    visit(child, childRect)
+                }
+            } else {
+                result.append((node, rect))
+            }
+        }
+        if !rootTilingContainer.children.isEmpty {
+            visit(rootTilingContainer, dwindleRect)
+        }
+        return result
+    }
+}
+
+private let orientedSplitKey = TreeNodeUserDataKey<Orientation>(key: "dwindleOrientedSplit")
+private let pinnedSplitKey = TreeNodeUserDataKey<Orientation>(key: "dwindlePinnedSplit")
+
+/// Hyprland's split direction for a box: side by side when wider than tall, stacked otherwise.
+func dwindleSplitOrientation(of rect: Rect) -> Orientation { rect.width >= rect.height ? .h : .v }
+
+/// Splits `target`, laid out at `targetRect`, the way Hyprland does: along its longer side, into a new container that
+/// takes `target`'s slot. Returns where the incoming window binds: the half `focal` falls in, or the second half.
+@MainActor
+func dwindleSplit(_ target: TreeNode, at targetRect: Rect, toward focal: CGPoint? = nil) -> BindingData {
+    guard let parent = target.parent as? TilingContainer, let index = target.ownIndex else {
+        die("Only nodes in a tiling container can be split")
+    }
+    let orientation = dwindleSplitOrientation(of: targetRect)
+    let weight = target.getWeight(parent.orientation)
+    let split = TilingContainer(parent: parent, adaptiveWeight: weight, orientation, .tiles, index: index)
+    target.bind(to: split, adaptiveWeight: WEIGHT_AUTO, index: 0)
+    let first = focal.map { $0.getProjection(orientation) < targetRect.center.getProjection(orientation) } ?? false
+    return BindingData(parent: split, adaptiveWeight: WEIGHT_AUTO, index: first ? 0 : 1)
+}
+
+extension TilingContainer {
+    /// Hyprland's removal: once a split is down to one child, that child takes the split's slot and size. The root
+    /// keeps a lone window, but hands its slot to a lone container.
+    @MainActor @discardableResult func promoteLoneChild() -> Bool {
+        guard let child = children.singleOrNil(), !(isRootContainer && child is Window) else { return false }
+        child.unbindFromParent()
+        let binding = unbindFromParent()
+        child.bind(to: binding.parent, adaptiveWeight: binding.adaptiveWeight, index: binding.index)
+        return true
+    }
+
+    /// The virtual rects `layoutTiles` gives the children when this container fills `rect`.
+    @MainActor func dwindleChildRects(in rect: Rect) -> [Rect] {
+        let weights = children.map { $0.getWeight(orientation) }
+        guard let delta = (rect.getDimension(orientation) - weights.reduce(0, +)).div(children.count) else { return [] }
+        var start = orientation == .h ? rect.minX : rect.minY
+        return weights.map { weight in
+            let length = weight + delta
+            defer { start += length }
+            return orientation == .h
+                ? Rect(topLeftX: start, topLeftY: rect.minY, width: length, height: rect.height)
+                : Rect(topLeftX: rect.minX, topLeftY: start, width: rect.width, height: length)
+        }
+    }
+
+    /// Folds wider containers into right-leaning binary chains (`[a, b, c]` becomes `[a, [b, c]]`, which is the
+    /// shape dwindle builds when windows open one after another) with Hyprland's default even splits, and promotes
+    /// lone children. Accordion stacks are left alone. Returns whether anything moved.
+    @MainActor fileprivate func binarize() -> Bool {
+        guard layout == .tiles else { return false }
+        var changed = false
+        if children.count > 2 {
+            let rest = Array(children.dropFirst())
+            let tail = TilingContainer(parent: self, adaptiveWeight: WEIGHT_AUTO, orientation, .tiles, index: INDEX_BIND_LAST)
+            for child in rest {
+                child.bind(to: tail, adaptiveWeight: WEIGHT_AUTO, index: INDEX_BIND_LAST)
+            }
+            for child in children {
+                child.setWeight(orientation, 1)
+            }
+            changed = true
+        }
+        for child in children {
+            if (child as? TilingContainer)?.binarize() == true { changed = true }
+        }
+        return promoteLoneChild() || changed
+    }
+
+    /// Pins every split a command flipped (`layout tiles horizontal vertical`) to its new orientation for as long as
+    /// the split exists. Hyprland's `preserve_split`, but only for splits the user turned. A flipped split is one
+    /// whose orientation differs from what `orientSplits` last left it in. `changeOrientation` flips the ancestors
+    /// along with the target, so only the deepest flipped split is pinned. Returns whether anything here was flipped.
+    @MainActor fileprivate func pinFlippedSplits() -> Bool {
+        guard layout == .tiles else { return false }
+        var flippedBelow = false
+        for child in children {
+            if (child as? TilingContainer)?.pinFlippedSplits() == true { flippedBelow = true }
+        }
+        guard let oriented = getUserData(key: orientedSplitKey), oriented != orientation else { return flippedBelow }
+        if !flippedBelow && children.count == 2 {
+            putUserData(key: pinnedSplitKey, data: orientation)
+        }
+        return true
+    }
+
+    /// Points every split along the longer side of its box, or its pinned orientation, rescaling the children so
+    /// they keep their proportions.
+    @MainActor fileprivate func orientSplits(in rect: Rect) {
+        guard layout == .tiles else { return }
+        let orientation = getUserData(key: pinnedSplitKey) ?? dwindleSplitOrientation(of: rect)
+        let previous = getUserData(key: orientedSplitKey) ?? self.orientation
+        if orientation != self.orientation {
+            setOwnOrientation(orientation)
+        }
+        if orientation != previous {
+            let weights = children.map { $0.getWeight(orientation) }
+            let total = weights.reduce(0, +)
+            let length = rect.getDimension(orientation)
+            for (child, weight) in zip(children, weights) {
+                child.setWeight(orientation, total > 0 ? weight / total * length : length / CGFloat(children.count))
+            }
+        }
+        putUserData(key: orientedSplitKey, data: orientation)
+        for (child, childRect) in zip(children, dwindleChildRects(in: rect)) {
+            (child as? TilingContainer)?.orientSplits(in: childRect)
+        }
+    }
+
+    /// `changeOrientation` also flips every ancestor when opposite-orientation normalization is on, but a split that
+    /// follows its own box may match its parent. Put the ancestors back nearest first: restoring one only touches it
+    /// and the containers above it.
+    @MainActor private func setOwnOrientation(_ orientation: Orientation) {
+        let ancestors = parents.filterIsInstance(of: TilingContainer.self)
+        let saved = ancestors.map(\.orientation)
+        changeOrientation(orientation)
+        for (ancestor, orientation) in zip(ancestors, saved) {
+            ancestor.changeOrientation(orientation)
+        }
+    }
+}
