@@ -0,0 +1,136 @@
+@testable import AppBundle
+import XCTest
+
+@MainActor
+final class DwindleLayoutTest: XCTestCase {
+    override func setUp() async throws { setUpWorkspacesForTests() }
+
+    func testDwindleLayoutInsertion() async throws {
+        config.enableNormalizationFlattenContainers = true
+        let workspace = Workspace.get(byName: name)
+
+        // 1. Insert first window (w1) into empty workspace
+        let w1 = TestWindow.new(id: 1, parent: workspace.rootTilingContainer)
+        w1.markAsMostRecentChild()
+        
+        // Root (H) -> [W1]
+        XCTAssertEqual(workspace.rootTilingContainer.children.count, 1)
+
+        // 2. Insert w2 (should just append to root since it only has 1 child)
+        let w2 = TestWindow.new(id: 2, parent: macosPopupWindowsContainer)
+        try await w2.relayoutWindow(on: workspace, forceTile: true)
+        w2.markAsMostRecentChild()
+
+        // Root (H) -> [W1, W2]
+        XCTAssertEqual(workspace.rootTilingContainer.children.count, 2)
+        XCTAssertEqual((workspace.rootTilingContainer.children[1] as? TestWindow)?.windowId, 2)
+
+        // 3. Insert w3 (w2 is MRU). Since root has 2 children, w3 should split w2.
+        // w2's parent is root (H). So new container is (V).
+        let w3 = TestWindow.new(id: 3, parent: macosPopupWindowsContainer)
+        try await w3.relayoutWindow(on: workspace, forceTile: true)
+        w3.markAsMostRecentChild()
+
+        // Root (H) -> [W1, V-Container[W2, W3]]
+        XCTAssertEqual(workspace.rootTilingContainer.children.count, 2)
+        let vContainer = workspace.rootTilingContainer.children[1] as! TilingContainer
+        XCTAssertEqual(vContainer.orientation, .v)
+        XCTAssertEqual(vContainer.children.count, 2)
+        XCTAssertEqual((vContainer.children[0] as? TestWindow)?.windowId, 2)
+        XCTAssertEqual((vContainer.children[1] as? TestWindow)?.windowId, 3)
+
+        // 4. Insert w4 (w3 is MRU). w3's parent is V-Container (which has 2 children).
+        // So w4 should split w3 into a new H-Container.
+        let w4 = TestWindow.new(id: 4, parent: macosPopupWindowsContainer)
+        try await w4.relayoutWindow(on: workspace, forceTile: true)
+        w4.markAsMostRecentChild()
+
+        // Root (H) -> [W1, V-Container[W2, H-Container[W3, W4]]]
+        XCTAssertEqual(vContainer.children.count, 2)
+        XCTAssertEqual((vContainer.children[0] as? TestWindow)?.windowId, 2)
+        let hContainer = vContainer.children[1] as! TilingContainer
+        XCTAssertEqual(hContainer.orientation, .h)
+        XCTAssertEqual(hContainer.children.count, 2)
+        XCTAssertEqual((hContainer.children[0] as? TestWindow)?.windowId, 3)
+        XCTAssertEqual((hContainer.children[1] as? TestWindow)?.windowId, 4)
+    }
+
+    func testDwindleLayout6Windows() async throws {
+        config.enableNormalizationFlattenContainers = true
+        let workspace = Workspace.get(byName: name)
+
+        // Add 6 windows sequentially, always focusing the newly added window.
+        for id in 1...6 {
+            let w = TestWindow.new(id: UInt32(id), parent: macosPopupWindowsContainer)
+            try await w.relayoutWindow(on: workspace, forceTile: true)
+            w.markAsMostRecentChild()
+        }
+        
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([
+                .window(1),
+                .v_tiles([
+                    .window(2),
+                    .h_tiles([
+                        .window(3),
+                        .v_tiles([
+                            .window(4),
+                            .h_tiles([
+                                .window(5),
+                                .window(6)
+                            ])
+                        ])
+                    ])
+                ])
+            ])
+        )
+    }
+
+    func testDwindleLayoutDeletion() async throws {
+        config.enableNormalizationFlattenContainers = true
+        let workspace = Workspace.get(byName: name)
+
+        // Setup 4 windows (H -> [W1, V -> [W2, H -> [W3, W4]]])
+        for id in 1...4 {
+            let w = TestWindow.new(id: UInt32(id), parent: macosPopupWindowsContainer)
+            try await w.relayoutWindow(on: workspace, forceTile: true)
+            w.markAsMostRecentChild()
+        }
+
+        // Verify initial setup
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([
+                .window(1),
+                .v_tiles([
+                    .window(2),
+                    .h_tiles([
+                        .window(3),
+                        .window(4)
+                    ])
+                ])
+            ])
+        )
+
+        // Close W3
+        let w3 = workspace.rootTilingContainer.allLeafWindowsRecursive.first(where: { ($0 as? TestWindow)?.windowId == 3 })!
+        w3.unbindFromParent()
+        
+        // This normally happens during event loops, we force it here
+        workspace.normalizeContainers()
+
+        // W4 was in an H-tiles container with W3. With W3 gone, H-tiles has 1 child (W4).
+        // Normalization should flatten H-tiles, leaving W4 inside V-tiles alongside W2.
+        assertEquals(
+            workspace.rootTilingContainer.layoutDescription,
+            .h_tiles([
+                .window(1),
+                .v_tiles([
+                    .window(2),
+                    .window(4)
+                ])
+            ])
+        )
+    }
+}

