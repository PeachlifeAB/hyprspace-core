@@ -0,0 +1,69 @@
+@testable import AppBundle
+import XCTest
+
+@MainActor
+final class DwindleBugTest: XCTestCase {
+    override func setUp() async throws { setUpWorkspacesForTests() }
+
+    func testDwindleLayoutStateAfterDeletion() async throws {
+        config.enableNormalizationFlattenContainers = true
+        config.enableNormalizationOppositeOrientationForNestedContainers = true
+        let workspace = Workspace.get(byName: name)
+        
+        XCTAssertEqual(workspace.rootTilingContainer.orientation, .h)
+
+        // 1. Insert two windows
+        let w1 = TestWindow.new(id: 1, parent: macosPopupWindowsContainer)
+        try await w1.relayoutWindow(on: workspace, .nonCancellable, forceTile: true)
+        w1.markAsMostRecentChild()
+        
+        let w2 = TestWindow.new(id: 2, parent: macosPopupWindowsContainer)
+        try await w2.relayoutWindow(on: workspace, .nonCancellable, forceTile: true)
+        w2.markAsMostRecentChild()
+        
+        // Root should be H, 2 windows
+        XCTAssertEqual(workspace.rootTilingContainer.orientation, .h)
+        XCTAssertEqual(workspace.rootTilingContainer.children.count, 2)
+        
+        // 2. Insert 3rd window (splits W2, creating V container)
+        let w3 = TestWindow.new(id: 3, parent: macosPopupWindowsContainer)
+        try await w3.relayoutWindow(on: workspace, .nonCancellable, forceTile: true)
+        w3.markAsMostRecentChild()
+        
+        XCTAssertEqual(workspace.rootTilingContainer.orientation, .h)
+        XCTAssertEqual(workspace.rootTilingContainer.children.count, 2)
+        let vContainer = workspace.rootTilingContainer.children[1] as! TilingContainer
+        XCTAssertEqual(vContainer.orientation, .v)
+        
+        // 3. Delete W1
+        w1.unbindFromParent()
+        workspace.normalizeContainers()
+        
+        // The H root is flattened away and the V container becomes the root. It now fills the whole landscape
+        // screen, so like Hyprland it splits side by side again.
+        XCTAssertEqual(workspace.rootTilingContainer.layoutDescription, .h_tiles([.window(2), .window(3)]))
+        
+        // 4. Delete all
+        w2.unbindFromParent()
+        w3.unbindFromParent()
+        workspace.normalizeContainers()
+        
+        // What is root orientation now? It should reset to H because it's empty!
+        XCTAssertEqual(workspace.rootTilingContainer.orientation, .h)
+        
+        // 5. Insert new window
+        let w4 = TestWindow.new(id: 4, parent: macosPopupWindowsContainer)
+        try await w4.relayoutWindow(on: workspace, .nonCancellable, forceTile: true)
+        w4.markAsMostRecentChild()
+        
+        // 6. Insert another window
+        let w5 = TestWindow.new(id: 5, parent: macosPopupWindowsContainer)
+        try await w5.relayoutWindow(on: workspace, .nonCancellable, forceTile: true)
+        w5.markAsMostRecentChild()
+        
+        // Will they be V or H?
+        // Since root is V, they will be V!
+        // But the user expects them to be H because it's a new dwindle tree.
+        XCTAssertEqual(workspace.rootTilingContainer.orientation, .h, "First split should ALWAYS be horizontal")
+    }
+}

