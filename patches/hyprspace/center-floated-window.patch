+    func testTilingToFloating_centersWindowAtDefaultSize() async {
+        let workspace = Workspace.get(byName: name)
+        var window: TestWindow!
+        workspace.rootTilingContainer.apply {
+            window = TestWindow.new(id: 1, parent: $0)
