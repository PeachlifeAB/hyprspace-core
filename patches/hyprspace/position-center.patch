@@ -0,0 +1,27 @@
+public struct PositionCmdArgs: CmdArgs {
+    public let rawArgsForStrRepr: EquatableNoop<StrArrSlice>
+    public init(rawArgs: StrArrSlice) { self.rawArgsForStrRepr = .init(rawArgs) }
+    public static let parser: CmdParser<Self> = cmdParser(
+        kind: .position,
+        allowInConfig: true,
+        help: "USAGE: aerospace position <preset>",
+        flags: [:],
+        posArgs: [newArgParser(\.targetPlacement, consumePlacement, mandatoryArgPlaceholder: "<preset>")]
+    )
+
+    public enum Placement: String, Equatable, Sendable {
+        case center
+    }
+
+    /*conforms*/ public var windowId: UInt32?
+    /*conforms*/ public var workspaceName: WorkspaceName?
+    public var targetPlacement: Lateinit<Placement> = .uninitialized
+}
+
+private func consumePlacement(i: ArgParserInput) -> ParsedCliArgs<PositionCmdArgs.Placement> {
+    if let placement = PositionCmdArgs.Placement(rawValue: i.arg) {
+        return .succ(placement, advanceBy: 1)
+    } else {
+        return .init(.failure("Invalid placement '\(i.arg)'. Expected 'center'"), advanceBy: 1)
+    }
+}

