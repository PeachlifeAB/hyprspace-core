@@ -0,0 +1,36 @@
+import AppKit
+import Common
+
+struct PositionCommand: Command {
+    let args: PositionCmdArgs
+
+    var shouldResetClosedWindowsCache: Bool = false
+    var shouldRefreshModel: Bool = false
+
+    func run(_ env: CmdEnv, _ io: CmdIo) async throws -> Bool {
+        guard let target = args.resolveTargetOrReportError(env, io) else { return false }
+        guard let window = target.windowOrNil else {
+            return io.err("No window in focus")
+        }
+
+        if !window.isFloating {
+            window.bindAsFloatingWindow(to: target.workspace)
+        }
+
+        let monitor = window.nodeMonitor ?? target.workspace.workspaceMonitor
+        let rect = monitor.visibleRect
+
+        let targetWidth = rect.width * 0.75
+        let targetHeight = rect.height * 0.75
+        let targetX = rect.minX + (rect.width * 0.125)
+        let targetY = rect.minY + (rect.height * 0.125)
+
+        let size = CGSize(width: targetWidth, height: targetHeight)
+        let topLeft = CGPoint(x: targetX, y: targetY)
+
+        window.setAxFrame(topLeft, size)
+        window.lastFloatingSize = size
+
+        return true
+    }
+}
