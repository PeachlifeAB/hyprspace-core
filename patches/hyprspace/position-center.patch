+import XCTest
+import Common
+@testable import AppBundle
+
+final class PositionCommandTest: XCTestCase {
+    func testParsePositionCenter() {
+        var expected = PositionCmdArgs(rawArgs: [])
+        expected.targetPlacement = .initialized(.center)
+        testParseSingleCommandSucc("position center", expected)
+    }
+
+    @MainActor
+    func testPositionCenter() async throws {
+        setUpWorkspacesForTests()
+
+        let workspace = Workspace.get(byName: "W")
+        let window = TestWindow.new(id: 1, parent: workspace.rootTilingContainer)
+        _ = window.focusWindow()
+
+        var expected = PositionCmdArgs(rawArgs: [])
+        expected.targetPlacement = .initialized(.center)
+        let command = PositionCommand(args: expected)
+
+        _ = try await command.run(.defaultEnv, .emptyStdin)
+
+        XCTAssertTrue(window.isFloating, "Window should be floating after position command")
+
+        let monitorRect = workspace.workspaceMonitor.visibleRect
+        if let rect = try await window.getAxRect(.nonCancellable) {
+            let expectedWidth = monitorRect.width * 0.75
+            let expectedHeight = monitorRect.height * 0.75
+            let expectedX = monitorRect.minX + (monitorRect.width * 0.125)
+            let expectedY = monitorRect.minY + (monitorRect.height * 0.125)
+
+            XCTAssertEqual(rect.width, expectedWidth, accuracy: 1.0)
+            XCTAssertEqual(rect.height, expectedHeight, accuracy: 1.0)
+            XCTAssertEqual(rect.minX, expectedX, accuracy: 1.0)
+            XCTAssertEqual(rect.minY, expectedY, accuracy: 1.0)
+        } else {
+            XCTFail("Window has no rect")
+        }

