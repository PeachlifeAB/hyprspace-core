diff --git a/Sources/AppBundle/command/impl/AppMenuCommand.swift b/Sources/AppBundle/command/impl/AppMenuCommand.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AppBundle/command/impl/AppMenuCommand.swift
@@ -0,0 +1,87 @@
+import AppKit
+import Common
+import Foundation
+
+struct AppMenuLeaf {
+    let element: AXUIElement
+    let leaf: String
+    let fullPath: String
+}
+
+struct AppMenuCommand: Command {
+    let args: AppMenuCmdArgs
+    /*conforms*/ let shouldResetClosedWindowsCache = false
+
+    @MainActor
+    func run(_ env: CmdEnv, _ io: CmdIo) async throws -> Bool {
+        guard let bundleId = args.appBundleId else {
+            return io.err("--app-bundle-id is required")
+        }
+        guard let leaves = try await activateAppAndCollectMenuLeaves(bundleId: bundleId, io: io) else {
+            return false
+        }
+        let pattern = (args.matchLeaf ?? (args.clickFirst ? "new" : nil)).map { $0.lowercased() }
+        let matched = pattern.map { p in leaves.filter { $0.leaf.lowercased().hasPrefix(p) } } ?? leaves
+        if args.clickFirst {
+            guard let element = matched.first else {
+                return io.err("No matching menu item found")
+            }
+            let actionResult = AXUIElementPerformAction(element.element, kAXPressAction as CFString)
+            guard actionResult == .success else {
+                return io.err("Failed to press menu item '\(element.fullPath)' for '\(bundleId)': AXError \(actionResult.rawValue)")
+            }
+            return true
+        }
+        for item in matched {
+            _ = io.out(item.fullPath)
+        }
+        return true
+    }
+}
+
+@MainActor
+func activateAppAndCollectMenuLeaves(bundleId: String, io: CmdIo) async throws -> [AppMenuLeaf]? {
+    guard let app = NSWorkspace.shared.runningApplications.first(where: {
+        $0.bundleIdentifier == bundleId
+    }) else {
+        return io.err("Application '\(bundleId)' is not running") ? nil : nil
+    }
+    app.activate(options: .activateIgnoringOtherApps)
+    var waited = 0
+    while NSWorkspace.shared.frontmostApplication?.bundleIdentifier != bundleId && waited < 20 {
+        try await Task.sleep(nanoseconds: 100_000_000)
+        waited += 1
+    }
+    try await Task.sleep(nanoseconds: 200_000_000)
+
+    let axApp = AXUIElementCreateApplication(app.processIdentifier)
+    var menuBarRaw: AnyObject?
+    guard AXUIElementCopyAttributeValue(axApp, kAXMenuBarAttribute as CFString, &menuBarRaw) == .success,
+          let menuBarRaw,
+          CFGetTypeID(menuBarRaw) == AXUIElementGetTypeID() else {
+        return io.err("Could not access menu bar for '\(bundleId)'") ? nil : nil
+    }
+    return collectLeaves(menuBarRaw as! AXUIElement)
+}
+
+private func collectLeaves(_ element: AXUIElement, path: [String] = [], actionElement: AXUIElement? = nil) -> [AppMenuLeaf] {
+    var childrenRaw: AnyObject?
+    guard AXUIElementCopyAttributeValue(element, kAXChildrenAttribute as CFString, &childrenRaw) == .success,
+          let children = childrenRaw as? [AXUIElement], !children.isEmpty else {
+        var titleRaw: AnyObject?
+        guard AXUIElementCopyAttributeValue(element, kAXTitleAttribute as CFString, &titleRaw) == .success,
+              let leaf = titleRaw as? String, !leaf.isEmpty else { return [] }
+        let fullPath = (path + [leaf]).joined(separator: " / ")
+        return [AppMenuLeaf(element: actionElement ?? element, leaf: leaf, fullPath: fullPath)]
+    }
+    return children.flatMap { child -> [AppMenuLeaf] in
+        var titleRaw: AnyObject?
+        AXUIElementCopyAttributeValue(child, kAXTitleAttribute as CFString, &titleRaw)
+        let title = (titleRaw as? String) ?? ""
+        var roleRaw: AnyObject?
+        AXUIElementCopyAttributeValue(child, kAXRoleAttribute as CFString, &roleRaw)
+        let role = roleRaw as? String
+        let nextActionElement = role == kAXMenuItemRole ? child : actionElement
+        return collectLeaves(child, path: title.isEmpty ? path : path + [title], actionElement: nextActionElement)
+    }
+}

