+public struct AppMenuCmdArgs: CmdArgs {
+    /*conforms*/ public var commonState: CmdArgsCommonState
+    public init(rawArgs: StrArrSlice) { self.commonState = .init(rawArgs) }
+    public static let parser: CmdParser<Self> = .init(
+        kind: .appMenu,
+        help: "USAGE: aerospace app-menu --app-bundle-id <id> [--match-leaf <pattern>] [--click-first]",
+        flags: [
+            "--app-bundle-id": singleValueSubArgParser(\.appBundleId, "<app-bundle-id>", Result.success),
+            "--match-leaf": singleValueSubArgParser(\.matchLeaf, "<pattern>", Result.success),
+            "--click-first": trueBoolFlag(\.clickFirst),
+        ],
+        posArgs: [],
+    )
+
+    public var appBundleId: String?
+    public var matchLeaf: String?
+    public var clickFirst: Bool = false
+}
