+public struct AppMenuCmdArgs: CmdArgs {
+    public let rawArgsForStrRepr: EquatableNoop<StrArrSlice>
+    public init(rawArgs: StrArrSlice) { self.rawArgsForStrRepr = .init(rawArgs) }
+    public static let parser: CmdParser<Self> = cmdParser(
+        kind: .appMenu,
+        allowInConfig: false,
+        help: "USAGE: aerospace app-menu --app-bundle-id <id> [--match-leaf <pattern>] [--click-first]",
+        flags: [
+            "--app-bundle-id": singleValueSubArgParser(\.appBundleId, "<app-bundle-id>") { $0 },
+            "--match-leaf": singleValueSubArgParser(\.matchLeaf, "<pattern>") { $0 },
+            "--click-first": trueBoolFlag(\.clickFirst),
+        ],
+        posArgs: [],
+    )
+
+    /*conforms*/ public var windowId: UInt32?
+    /*conforms*/ public var workspaceName: WorkspaceName?
+    public var appBundleId: String?
+    public var matchLeaf: String?
+    public var clickFirst: Bool = false
+}

