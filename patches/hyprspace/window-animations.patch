+    /// AXEnhancedUserInterface makes apps animate frame changes themselves and fight ours. `setAxFrame` turns it off
+    /// around every write; an animation turns it off once for the app and back on when its last window settles.
+    func animationStarted() {
+        animatingWindows += 1
+        guard animatingWindows == 1 else { return }
+        _ = thread?.runInLoopAsync(job: RunLoopJob(.nonCancellable)) { [axApp, enhancedUserInterfaceBeforeAnimation] _ in
+            let app = axApp.threadGuarded
+            enhancedUserInterfaceBeforeAnimation.wasEnabled = app.get(Ax.enhancedUserInterfaceAttr) == true
+            if enhancedUserInterfaceBeforeAnimation.wasEnabled { app.set(Ax.enhancedUserInterfaceAttr, false) }
+        }
+    }
+
+    func animationEnded() {
+        guard animatingWindows > 0 else { return }
+        animatingWindows -= 1
+        guard animatingWindows == 0 else { return }
+        _ = thread?.runInLoopAsync(job: RunLoopJob(.nonCancellable)) { [axApp, enhancedUserInterfaceBeforeAnimation] _ in
+            if enhancedUserInterfaceBeforeAnimation.wasEnabled { axApp.threadGuarded.set(Ax.enhancedUserInterfaceAttr, true) }
+            enhancedUserInterfaceBeforeAnimation.wasEnabled = false
+        }
+    }
+
+    /// One frame of an animation, marking `write` once performed. AXEnhancedUserInterface is already off for the
+    /// animation (`animationStarted`), and an in-between frame needs no edge-of-screen size fix-up: a move is one
+    /// position write and a morph two writes. The final full write still goes through `setAxFrame`.
+    func setAxFrameForAnimation(_ windowId: UInt32, _ topLeft: CGPoint, _ size: CGSize?, _ write: AnimationWrite) {
+        setFrameJobs.removeValue(forKey: windowId)?.cancel()
+        setFrameJobs[windowId] = withWindowAsync(windowId, .cancellable) { window, job in
+            if let size {
+                // Shrink before moving and move before growing, so the window never pokes past where it is
+                // going and gets clamped by the screen edge.
+                let growing = (window.get(Ax.sizeAttr).map { size.width > $0.width || size.height > $0.height }) ?? false
+                if growing {
+                    window.set(Ax.topLeftCornerAttr, topLeft)
+                    try job.checkCancellation()
+                    window.set(Ax.sizeAttr, size)
+                } else {
+                    window.set(Ax.sizeAttr, size)
+                    try job.checkCancellation()
+                    window.set(Ax.topLeftCornerAttr, topLeft)
+                }
+            } else {
+                window.set(Ax.topLeftCornerAttr, topLeft)
+            }
+            write.markLanded()
+        }
+    }
