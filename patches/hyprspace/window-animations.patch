+@MainActor
+private final class AnimationTestClock {
+    var now = 0.0
+}
+
+private final class AnimationTestWindow: Window {
+    struct Request {
+        let position: CGPoint?
+        let size: CGSize?
+        let write: AnimationWrite
+    }
+
+    var animationFrames: [Request] = []
+    var finalFrames: [CGRect] = []
+    var completeImmediately = true
+    var starts = 0
+    var ends = 0
+    var cancellations = 0
+    var deferRegularWrites = false
+    var appliedFrame: CGRect?
+    private var pendingFrame: CGRect?
+    private var animationWrite: AnimationWrite?
+
+    @MainActor
+    init(_ id: UInt32, _ parent: NonLeafTreeNodeObject) {
+        super.init(id: id, TestApp.shared, lastFloatingSize: nil, parent: parent, adaptiveWeight: 1, index: INDEX_BIND_LAST)
+    }
+
+    override func animationStarted() { starts += 1 }
+    override func animationEnded() { ends += 1 }
+    override func cancelAxFrame() {
+        cancellations += 1
+        animationWrite?.complete(.cancelled)
+        animationWrite = nil
+        pendingFrame = nil
+    }
+
+    override func cancelAnimationAxFrame() {
+        guard animationWrite != nil else { return }
+        cancelAxFrame()
+    }
+
+    override func setAxFrame(_ topLeft: CGPoint?, _ size: CGSize?) {
+        cancelAxFrame()
+        if let topLeft, let size {
+            let frame = CGRect(origin: topLeft, size: size)
+            finalFrames.append(frame)
+            if deferRegularWrites { pendingFrame = frame } else { appliedFrame = frame }
+        }
+    }
+
+    override func setAxFrameForAnimation(_ topLeft: CGPoint?, _ size: CGSize?, _ write: AnimationWrite) {
+        cancelAxFrame()
+        animationWrite = write
+        animationFrames.append(Request(position: topLeft, size: size, write: write))
+        if completeImmediately { write.complete(.applied) }
+    }
+
+    func applyPendingFrame() {
+        if let pendingFrame { appliedFrame = pendingFrame }
+        pendingFrame = nil
+    }
+
+    override func getAxRect(_ cm: CancellationMode) async throws -> Rect? {
+        appliedFrame.map { Rect(topLeftX: $0.minX, topLeftY: $0.minY, width: $0.width, height: $0.height) }
+    }
+}

