--- /dev/null
+++ b/Sources/AppBundle/layout/WindowAnimator.swift
@@ -0,0 +1,577 @@
+import AppKit
+import Common
+import QuartzCore
+
+// Tiled windows glide to their new frames instead of jumping. Each window rides a spring from where it is to its
+// tile, stepped on every display frame and written through the app's AX thread, which already drops a write that a
+// newer one overtook. Once a window arrives it gets one regular full write. A new layout mid-flight retargets the
+// spring, so the window curves to its new tile instead of restarting.
+//
+// Two styles:
+// - `fancy` morphs the whole frame on a soft spring. A window's position and size can only be set by two separate
+//   AX writes, and an app may draw in between: a window whose left edge moves while its width changes makes its
+//   right edge, which should stay put, jump back and forth every frame. So no frame changes both. A window that
+//   only moves or only resizes rides one spring; one that does both shrinks in place, slides, then grows in place
+//   (`fancyPhases`), each phase a single kind of write. AXEnhancedUserInterface is turned off once per app for the
+//   whole animation instead of being checked around every write.
+// - `fast` only slides. Resizing makes an app lay its content out again, which browsers, terminals and Electron
+//   apps can't do at display rate, so the window shrinks to the smaller of its old and new size up front, moves
+//   with one position write per frame on a stiffer spring, and grows into its tile with the final write.
+//
+// An app's AX thread serves all of its windows one write at a time. Keep only one animation write in flight per
+// window, skip unchanged rounded frames, and sample elapsed time when the app catches up. An absolute deadline
+// bounds the whole move (not each phase), so a slow or unresponsive app cannot stretch the spring indefinitely.
+// If resizing proves too slow, finish with a cheap slide and one final resize instead of continuing to relayout
+// the app on every display frame.
+//
+// The spring and frame stepping are adapted from Dinky (https://github.com/mikker/Dinky, MIT).
+
+/// A damped spring on one value: `response` is roughly the time to arrive, `damping` 1 arrives without overshoot.
+/// The exact damped-oscillator solution keeps the motion independent of refresh rate and AX write latency.
+struct Spring: Equatable {
+    let response: Double
+    let stiffness: Double
+    let friction: Double
+
+    init(response: Double, damping: Double) {
+        self.response = response
+        let omega = 2 * Double.pi / max(response, 0.001)
+        stiffness = omega * omega
+        friction = 2 * damping * omega
+    }
+
+    /// Advance `value` and `velocity` towards `target` by `dt` seconds.
+    func step(_ value: inout Double, _ velocity: inout Double, to target: Double, dt: Double) {
+        guard dt > 0 else { return }
+        let displacement = value - target
+        let decay = friction / 2
+        let discriminant = decay * decay - stiffness
+        if abs(discriminant) < stiffness * 1e-8 {
+            let b = velocity + decay * displacement
+            let envelope = exp(-decay * dt)
+            value = target + envelope * (displacement + b * dt)
+            velocity = envelope * (velocity - decay * b * dt)
+        } else if discriminant < 0 {
+            let frequency = sqrt(-discriminant)
+            let sine = sin(frequency * dt)
+            let cosine = cos(frequency * dt)
+            let envelope = exp(-decay * dt)
+            value = target + envelope * (displacement * cosine + (velocity + decay * displacement) / frequency * sine)
+            velocity = envelope * (velocity * cosine - (decay * velocity + stiffness * displacement) / frequency * sine)
+        } else {
+            let root = sqrt(discriminant)
+            let slow = -decay + root
+            let fast = -decay - root
+            let a = (velocity - fast * displacement) / (slow - fast)
+            let b = displacement - a
+            let slowPart = a * exp(slow * dt)
+            let fastPart = b * exp(fast * dt)
+            value = target + slowPart + fastPart
+            velocity = slow * slowPart + fast * fastPart
+        }
+    }
+}
+
+/// One window moving from where it is to its tile: x, y, width and height each on the same spring, so shared edges
+/// of neighbouring windows move together.
+struct FrameAnimation: Equatable {
+    private(set) var target: CGRect
+    private var value: [Double]
+    private var velocity: [Double] = [0, 0, 0, 0]
+    /// Seconds since the target last changed, to give up on one that never settles.
+    private var age: Double = 0
+
+    init(from start: CGRect, to target: CGRect) {
+        self.target = target
+        value = Self.components(start)
+    }
+
+    /// The frame now, rounded to whole points so a pure move does not jitter the size.
+    var frame: CGRect {
+        CGRect(x: value[0].rounded(), y: value[1].rounded(), width: value[2].rounded(), height: value[3].rounded())
+    }
+
+    /// Head somewhere else, keeping the current position and speed so the motion stays continuous.
+    mutating func retarget(_ new: CGRect, preserving writes: PhaseWrites = .both) {
+        target = new
+        age = 0
+        // Preserve momentum on the axes the next phase actually changes. Frozen axes must not coast past their
+        // requested frame, otherwise a position-only AX write would leave the model and the real size disagreeing.
+        let goal = Self.components(new)
+        let frozen = writes == .position ? [2, 3] : writes == .size ? [0, 1] : []
+        for i in frozen {
+            value[i] = goal[i]
+            velocity[i] = 0
+        }
+    }
+
+    /// Advance by `dt` seconds. True once within `settle` of the target, or after `timeout` seconds.
+    mutating func step(_ spring: Spring, dt: Double, timeout: Double, settle: Settle = .exact) -> Bool {
+        age += dt
+        let goal = Self.components(target)
+        for i in 0 ..< 4 { spring.step(&value[i], &velocity[i], to: goal[i], dt: dt) }
+        let settled = (0 ..< 4).allSatisfy { abs(value[$0] - goal[$0]) < settle.distance && abs(velocity[$0]) < settle.speed }
+        if settled || age >= timeout {
+            value = goal
+            velocity = [0, 0, 0, 0]
+            return true
+        }
+        return false
+    }
+
+    private static func components(_ r: CGRect) -> [Double] {
+        [Double(r.minX), Double(r.minY), Double(r.width), Double(r.height)]
+    }
+}
+
+/// How close to its target, and how slow, a window must be for the final write to land it.
+struct Settle: Equatable {
+    let distance: Double
+    let speed: Double
+
+    /// Rides the spring all the way in.
+    static let exact = Settle(distance: 0.5, speed: 10)
+    /// The last few points of a spring crawl in for longer than the rest of the move took. Within 3 pt and slower
+    /// than 100 pt/s, the final write lands the window without a visible jump.
+    static let early = Settle(distance: 3, speed: 100)
+}
+
+@MainActor
+final class WindowAnimator: NSObject {
+    static let shared = WindowAnimator()
+
+    private struct Entry {
+        /// Held so the app's animation state can be released even once the window is gone.
+        let window: Window
+        var animation: FrameAnimation
+        /// The size the window keeps while it slides (`fast`), or nil when its size is animated too (`fancy`).
+        var slideSize: CGSize?
+        /// The `fancy` phases still to come after the current one, and what the current one writes.
+        var phases: [CGRect] = []
+        var writes: PhaseWrites = .both
+        /// The spring the phases of a multi-phase move ride: each a share of the duration.
+        var phaseSpring: Spring?
+        /// The write the window's app has yet to perform, and when it was sent.
+        var inFlight: (write: AnimationWrite, sentAt: CFTimeInterval)?
+        var lastAdvance: CFTimeInterval
+        /// Bounds all phases together, even if AX never completes a write.
+        var deadline: CFTimeInterval
+        var lastSentFrame: CGRect
+    }
+
+    private var entries: [UInt32: Entry] = [:]
+    /// The frame each tiled window was last asked to take: where it rests when nothing is moving it.
+    private var targets: [UInt32: CGRect] = [:]
+    /// Windows whose start frame is being read, with the frame they should glide to once it is known.
+    private var pendingStarts: [UInt32: CGRect] = [:]
+    /// Windows coming back from a corner of the screen: their next frame is a jump, not a glide from the corner.
+    private var jumpNext: Set<UInt32> = []
+    /// Until when the AX move and resize events a window sends are still the echo of its final write.
+    private var quietUntil: [UInt32: CFTimeInterval] = [:]
+    private var spring = Spring(response: 0.15, damping: 0.9)
+    private var settle = Settle.exact
+    private var timeout = 1.0
+    private var springConfig: Animations? = nil
+    private var displayLink: AnyObject? = nil
+    private var timer: Timer? = nil
+    private let animationOverride: Animations?
+    private let clock: () -> CFTimeInterval
+
+    /// An override provides deterministic, headless scheduler tests without starting a display link.
+    init(animations: Animations? = nil, clock: @escaping () -> CFTimeInterval = CACurrentMediaTime) {
+        animationOverride = animations
+        self.clock = clock
+        super.init()
+    }
+
+    private var settings: Animations { animationOverride ?? config.animations }
+    private var timeBudget: Double { max(1.0 / 30, 2 * Double(settings.durationMs) / 1000) }
+
+    private var isEnabled: Bool {
+        settings.enabled && settings.durationMs > 0 && (animationOverride != nil ||
+            (!isUnitTest && !NSWorkspace.shared.accessibilityDisplayShouldReduceMotion))
+    }
+
+    /// A tiled window being moved or resized with the mouse drags its neighbours along live; gliding them would lag.
+    /// A floating one (a modifier drag) leaves the others to reflow, which can glide.
+    private var isResizingTiledWindowWithMouse: Bool {
+        currentlyManipulatedWithMouseWindowId.flatMap { Window.get(byId: $0) }.map { !$0.isFloating } ?? false
+    }
+
+    /// Whether the window is gliding right now, so the AX move and resize events it sends are not the user's.
+    func isAnimating(_ windowId: UInt32) -> Bool {
+        entries[windowId] != nil || quietUntil[windowId].map { clock() < $0 } == true
+    }
+
+    /// Put a tiled window at `topLeft`/`size`, gliding there from its previous frame when animations are on.
+    func setFrame(_ window: Window, _ topLeft: CGPoint, _ size: CGSize) {
+        let id = window.windowId
+        let target = CGRect(origin: topLeft, size: size)
+        let previous = targets.updateValue(target, forKey: id)
+        // Floating fullscreen is a one-shot placement whose request is cleared by the layout pass. It must land
+        // immediately: the next floating layout forgets tiling animations and would interrupt a phased move.
+        guard isEnabled, case .tilingContainer = window.windowParentCases, !isResizingTiledWindowWithMouse else {
+            removeEntry(id)
+            pendingStarts[id] = nil
+            jumpNext.remove(id)
+            window.setAxFrame(topLeft, size)
+            return
+        }
+        syncSpring()
+        if var entry = entries[id], entry.slideSize == nil {
+            guard (entry.phases.last ?? entry.animation.target) != target else { return }
+            let current = entry.animation.frame
+            let phases = fancyPhases(from: current, to: target)
+            entry.phases = Array(phases.dropFirst())
+            entry.writes = PhaseWrites(from: current, to: phases[0])
+            entry.animation.retarget(phases[0], preserving: entry.writes)
+            entry.phaseSpring = phaseSpring(phases.count)
+            entry.lastAdvance = clock()
+            entry.deadline = entry.lastAdvance + timeBudget
+            entries[id] = entry
+            return
+        }
+        if let entry = entries[id] {
+            guard entry.animation.target != target else { return }
+            entries[id]?.animation.retarget(target)
+            entries[id]?.lastAdvance = clock()
+            entries[id]?.deadline = clock() + timeBudget
+            if let slideSize = entry.slideSize {
+                let smaller = slideSize.shrunk(to: target.size)
+                if smaller != slideSize {
+                    entries[id]?.slideSize = smaller
+                    entries[id]?.inFlight = send(window, entry.animation.frame.origin, smaller)
+                    entries[id]?.lastSentFrame = CGRect(origin: entry.animation.frame.origin, size: smaller)
+                }
+            }
+            return
+        }
+        if pendingStarts[id] != nil {
+            pendingStarts[id] = target
+            return
+        }
+        if jumpNext.remove(id) != nil {
+            window.setAxFrame(topLeft, size)
+            return
+        }
+        if let previous {
+            if previous.isClose(to: target) {
+                window.setAxFrame(topLeft, size) // Nothing to glide; reassert the frame as an unanimated layout would
+            } else {
+                start(id, from: previous, to: target)
+            }
+            return
+        }
+        // Never laid out here before (a new window, the end of a mouse drag, back from floating):
+        // glide from wherever the window actually is.
+        pendingStarts[id] = target
+        Task { @MainActor [weak self] in
+            let actual = try? await window.getAxRect(.cancellable)
+            guard let self, let target = pendingStarts.removeValue(forKey: id) else { return }
+            if let actual, actual.width > 0, actual.height > 0, !actual.cgRect.isClose(to: target) {
+                start(id, from: actual.cgRect, to: target)
+            } else {
+                window.setAxFrame(target.origin, target.size)
+            }
+        }
+    }
+
+    /// Drop obsolete tiling state without cancelling a newer regular placement, such as floating centering.
+    func forget(_ windowId: UInt32) {
+        if let window = entries[windowId]?.window ?? Window.get(byId: windowId),
+           entries[windowId] != nil || quietUntil[windowId] != nil
+        {
+            window.cancelAnimationAxFrame()
+        }
+        removeEntry(windowId)
+        pendingStarts[windowId] = nil
+        targets[windowId] = nil
+        quietUntil[windowId] = nil
+        if entries.isEmpty { stop() }
+    }
+
+    /// Mouse takeover also cancels a pending regular final write; ordinary layout cleanup must preserve it.
+    func interrupt(_ windowId: UInt32) {
+        (entries[windowId]?.window ?? Window.get(byId: windowId))?.cancelAxFrame()
+        forget(windowId)
+    }
+
+    /// The window is about to be parked in a corner of the screen; when it returns it jumps back into place.
+    func hide(_ windowId: UInt32) {
+        forget(windowId)
+        jumpNext.insert(windowId)
+    }
+
+    private func syncSpring() {
+        guard springConfig?.durationMs != settings.durationMs || springConfig?.style != settings.style
+        else { return }
+        springConfig = settings
+        let duration = Double(settings.durationMs) / 1000
+        // Either way a window is in place in roughly `duration-ms`; `fast` gets there with a stiffer spring that
+        // stops early, `fancy` with a softer one ridden all the way in.
+        switch settings.style {
+            case .fancy:
+                spring = Spring(response: duration, damping: 0.9)
+                settle = .exact
+            case .fast:
+                spring = Spring(response: 0.7 * duration, damping: 0.9)
+                settle = .early
+        }
+        timeout = max(0.4, 4 * spring.response)
+    }
+
+    func start(_ id: UInt32, from: CGRect, to target: CGRect) {
+        guard let window = Window.get(byId: id) else { return }
+        syncSpring()
+        let now = clock()
+        var entry = Entry(
+            window: window, animation: FrameAnimation(from: from, to: target),
+            lastAdvance: now, deadline: now + timeBudget, lastSentFrame: from,
+        )
+        window.animationStarted()
+        switch settings.style {
+            case .fast:
+                let slideSize = from.size.shrunk(to: target.size)
+                entry.slideSize = slideSize
+                entry.writes = .position
+                if slideSize != from.size {
+                    entry.inFlight = send(window, from.origin, slideSize) // The slide starts once the window has shrunk
+                    entry.lastSentFrame = CGRect(origin: from.origin, size: slideSize)
+                }
+            case .fancy:
+                let phases = fancyPhases(from: from, to: target)
+                entry.animation = FrameAnimation(from: from, to: phases[0])
+                entry.phases = Array(phases.dropFirst())
+                entry.writes = PhaseWrites(from: from, to: phases[0])
+                entry.phaseSpring = phaseSpring(phases.count)
+        }
+        entries[id] = entry
+        run()
+    }
+
+    /// A move split into `count` phases gives each a share of the duration, so the whole stays close to it.
+    private func phaseSpring(_ count: Int) -> Spring? {
+        count > 1 ? Spring(response: spring.response * max(0.4, 1.2 / Double(count)), damping: 0.9) : nil
+    }
+
+    private func removeEntry(_ id: UInt32) {
+        entries.removeValue(forKey: id)?.window.animationEnded()
+    }
+
+    private func run() {
+        guard animationOverride == nil else { return }
+        if displayLink != nil || timer != nil { return }
+        if #available(macOS 14.0, *), let screen = NSScreen.main ?? NSScreen.screens.first {
+            let link = screen.displayLink(target: self, selector: #selector(tick(_:)))
+            link.add(to: .main, forMode: .common)
+            displayLink = link
+        } else {
+            let timer = Timer(timeInterval: 1.0 / 120, repeats: true) { _ in
+                MainActor.assumeIsolated { WindowAnimator.shared.step(now: CACurrentMediaTime()) }
+            }
+            RunLoop.main.add(timer, forMode: .common)
+            self.timer = timer
+        }
+    }
+
+    private func stop() {
+        if #available(macOS 14.0, *) { (displayLink as? CADisplayLink)?.invalidate() }
+        displayLink = nil
+        timer?.invalidate()
+        timer = nil
+    }
+
+    @available(macOS 14.0, *)
+    @objc private func tick(_ link: CADisplayLink) {
+        step(now: link.timestamp)
+    }
+
+    private func send(_ window: Window, _ frame: CGRect, _ writes: PhaseWrites) -> (AnimationWrite, CFTimeInterval) {
+        switch writes {
+            case .position: send(window, frame.origin, nil)
+            case .size: send(window, nil, frame.size)
+            case .both: send(window, frame.origin, frame.size)
+        }
+    }
+
+    private func send(_ window: Window, _ topLeft: CGPoint?, _ size: CGSize?) -> (AnimationWrite, CFTimeInterval) {
+        let write = AnimationWrite()
+        window.setAxFrameForAnimation(topLeft, size, write)
+        return (write, clock())
+    }
+
+    func step(now: CFTimeInterval) {
+        for (id, entry) in entries {
+            guard let window = Window.get(byId: id), case .tilingContainer = window.windowParentCases,
+                  window.windowId != currentlyManipulatedWithMouseWindowId
+            else {
+                forget(id)
+                continue
+            }
+            let target = entry.phases.last ?? entry.animation.target
+            // Supersession takes priority even after a delayed display tick has passed the deadline.
+            if entry.inFlight?.write.result == .cancelled {
+                forget(id)
+                continue
+            }
+            // Queue the final frame once, cancelling stale queued updates. This bounds scheduling time; it cannot
+            // make an unresponsive external app perform the AX write by the deadline.
+            if now >= entry.deadline {
+                finish(id, window, target, now: now)
+                continue
+            }
+            if let (write, sentAt) = entry.inFlight {
+                switch write.result {
+                    case .pending:
+                        if now - sentAt < 0.1 { continue }
+                        finish(id, window, target, now: now)
+                        continue
+                    case .failed:
+                        finish(id, window, target, now: now)
+                        continue
+                    case .cancelled:
+                        // A newer explicit placement owns the window now. Reasserting the old goal here would
+                        // overwrite it even before the subsequent floating layout has a chance to forget us.
+                        forget(id)
+                        continue
+                    case .applied: break
+                }
+            }
+            var entry = entry
+            if let (_, sentAt) = entry.inFlight,
+               entry.slideSize == nil, entry.writes != .position,
+               now - sentAt > max(1.0 / 30, Double(settings.durationMs) / 4000)
+            {
+                // The preceding resize completed, so this is the best known applied frame. Do not reset the
+                // whole-move deadline when degrading; a slow app must not buy a fresh animation budget.
+                let current = entry.lastSentFrame
+                let smaller = current.size.shrunk(to: target.size)
+                entry.animation = FrameAnimation(from: current, to: target)
+                entry.slideSize = smaller
+                entry.phases = []
+                entry.phaseSpring = nil
+                entry.writes = .position
+                entry.lastAdvance = now
+                entry.inFlight = nil
+                if smaller != current.size {
+                    entry.inFlight = send(window, current.origin, smaller)
+                    entry.lastSentFrame = CGRect(origin: current.origin, size: smaller)
+                }
+                entries[id] = entry
+                continue
+            }
+            entry.inFlight = nil
+            // Do not discard elapsed time after a slow AX write. The analytic spring remains stable for long dt.
+            let dt = max(0, now - entry.lastAdvance)
+            entry.lastAdvance = now
+            let lastPhase = entry.phases.isEmpty
+            // The phases of a split move each get a share of the duration and hand over as soon as they are
+            // close, so the whole move takes about as long as a single-phase one.
+            let done = entry.animation.step(
+                entry.phaseSpring ?? spring,
+                dt: dt,
+                timeout: timeout,
+                settle: entry.phaseSpring == nil ? settle : .early,
+            )
+            let frame = entry.animation.frame
+            if done && lastPhase {
+                finish(id, window, target, now: now)
+                continue
+            }
+            let output = CGRect(origin: frame.origin, size: entry.slideSize ?? frame.size)
+            if let writes = PhaseWrites.changed(from: entry.lastSentFrame, to: output) {
+                entry.inFlight = send(window, output, writes)
+                entry.lastSentFrame = output
+            }
+            if done {
+                let next = entry.phases.removeFirst()
+                entry.writes = PhaseWrites(from: frame, to: next)
+                entry.animation.retarget(next, preserving: entry.writes)
+            }
+            entries[id] = entry
+        }
+        quietUntil = quietUntil.filter { $0.value > now }
+        if entries.isEmpty { stop() }
+    }
+
+    private func finish(_ id: UInt32, _ window: Window, _ target: CGRect, now: CFTimeInterval) {
+        quietUntil[id] = now + 0.25
+        window.setAxFrame(target.origin, target.size)
+        removeEntry(id) // Restore per-app state only after queuing the final frame.
+    }
+}
+
+/// What a phase of an animation changes, and so which AX writes each of its frames needs.
+enum PhaseWrites: Equatable {
+    case position, size, both
+
+    static func changed(from: CGRect, to: CGRect) -> PhaseWrites? {
+        if from == to { return nil }
+        if from.origin == to.origin { return .size }
+        if from.size == to.size { return .position }
+        return .both
+    }
+
+    init(from: CGRect, to: CGRect) {
+        if from.origin.isClose(to: to.origin) {
+            self = .size
+        } else if from.size.isClose(to: to.size) {
+            self = .position
+        } else {
+            self = .both
+        }
+    }
+}
+
+/// The phases of a `fancy` move from `from` to `to`, as the frame each one ends on. A window that only moves, or
+/// only resizes in place, takes one phase. One that does both shrinks in place to the smaller of its two sizes,
+/// slides, then grows in place, so no frame needs both a position and a size write.
+func fancyPhases(from: CGRect, to: CGRect) -> [CGRect] {
+    if from.origin.isClose(to: to.origin) || from.size.isClose(to: to.size) { return [to] }
+    let small = from.size.shrunk(to: to.size)
+    var phases: [CGRect] = []
+    if !small.isClose(to: from.size) { phases.append(CGRect(origin: from.origin, size: small)) }
+    phases.append(CGRect(origin: to.origin, size: small))
+    if !small.isClose(to: to.size) { phases.append(to) }
+    return phases
+}
+
+extension CGPoint {
+    fileprivate func isClose(to other: CGPoint) -> Bool { abs(x - other.x) < 1 && abs(y - other.y) < 1 }
+}
+
+/// Completion of an AX request, not acknowledgement that the app has presented a frame on screen.
+final class AnimationWrite: @unchecked Sendable {
+    enum Result: Equatable { case pending, applied, failed, cancelled }
+    private let lock = NSLock()
+    private var completion: Result = .pending
+
+    var result: Result { lock.withLock { completion } }
+    func complete(_ result: Result) {
+        lock.withLock {
+            guard completion == .pending else { return }
+            completion = result
+        }
+    }
+}
+
+extension Rect {
+    fileprivate var cgRect: CGRect { CGRect(x: topLeftX, y: topLeftY, width: width, height: height) }
+}
+
+extension CGSize {
+    /// The smaller of the two sizes in each dimension.
+    fileprivate func shrunk(to other: CGSize) -> CGSize {
+        CGSize(width: min(width, other.width), height: min(height, other.height))
+    }
+
+    fileprivate func isClose(to other: CGSize) -> Bool { abs(width - other.width) < 1 && abs(height - other.height) < 1 }
+}
+
+extension CGRect {
+    /// Every edge within `tolerance` points of the other rect's.
+    fileprivate func isClose(to other: CGRect, within tolerance: CGFloat = 1) -> Bool {
+        abs(minX - other.minX) <= tolerance && abs(minY - other.minY) <= tolerance &&
+            abs(maxX - other.maxX) <= tolerance && abs(maxY - other.maxY) <= tolerance
+    }
+}

