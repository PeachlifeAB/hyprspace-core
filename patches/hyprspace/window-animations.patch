diff --git a/Sources/AppBundleTests/layout/WindowAnimatorTest.swift b/Sources/AppBundleTests/layout/WindowAnimatorTest.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AppBundleTests/layout/WindowAnimatorTest.swift
@@ -0,0 +1,653 @@
+@testable import AppBundle
+import Common
+import XCTest
+
+final class WindowAnimatorTest: XCTestCase {
+    func testAnimationArrivesOnTarget() {
+        let target = CGRect(x: 500, y: 0, width: 400, height: 900)
+        var animation = FrameAnimation(from: CGRect(x: 0, y: 0, width: 800, height: 900), to: target)
+        let spring = Spring(response: 0.15, damping: 0.9)
+        var steps = 0
+        while !animation.step(spring, dt: 1.0 / 120, timeout: 1) { steps += 1 }
+        assertEquals(animation.frame, target)
+        assertTrue(steps > 5) // It glides rather than jumping
+        assertTrue(steps < 120) // and settles well before the timeout
+    }
+
+    func testAnimationMovesMonotonicallyWithoutOvershootingMuch() {
+        var animation = FrameAnimation(from: CGRect(x: 0, y: 0, width: 100, height: 100), to: CGRect(x: 1000, y: 0, width: 100, height: 100))
+        let spring = Spring(response: 0.15, damping: 0.9)
+        var maxX: CGFloat = 0
+        while !animation.step(spring, dt: 1.0 / 120, timeout: 1) { maxX = max(maxX, animation.frame.minX) }
+        assertTrue(maxX < 1010)
+    }
+
+    func testRetargetKeepsCurrentPosition() {
+        var animation = FrameAnimation(from: .zero, to: CGRect(x: 1000, y: 0, width: 0, height: 0))
+        let spring = Spring(response: 0.15, damping: 0.9)
+        for _ in 0 ..< 5 { _ = animation.step(spring, dt: 1.0 / 120, timeout: 1) }
+        let before = animation.frame
+        animation.retarget(CGRect(x: -1000, y: 0, width: 0, height: 0))
+        assertEquals(animation.frame, before)
+        assertEquals(animation.target, CGRect(x: -1000, y: 0, width: 0, height: 0))
+    }
+
+    func testEarlySettleLandsSoonerThanExact() {
+        func steps(_ settle: Settle) -> Int {
+            var animation = FrameAnimation(from: .zero, to: CGRect(x: 1000, y: 0, width: 0, height: 0))
+            var steps = 0
+            while !animation.step(Spring(response: 0.15, damping: 0.9), dt: 1.0 / 120, timeout: 1, settle: settle) { steps += 1 }
+            assertEquals(animation.frame, CGRect(x: 1000, y: 0, width: 0, height: 0))
+            return steps
+        }
+        assertTrue(steps(.early) < steps(.exact))
+    }
+
+    func testFancyPhasesKeepSingleKindMovesInOnePhase() {
+        let from = CGRect(x: 0, y: 0, width: 500, height: 500)
+        let moved = CGRect(x: 600, y: 0, width: 500, height: 500)
+        let resized = CGRect(x: 0, y: 0, width: 800, height: 300)
+        assertEquals(fancyPhases(from: from, to: moved), [moved])
+        assertEquals(fancyPhases(from: from, to: resized), [resized])
+    }
+
+    func testFancyPhasesSplitMoveAndResize() {
+        // Growing leftwards (right edge fixed): slide at the old size, then grow in place.
+        let right = CGRect(x: 1000, y: 0, width: 1000, height: 800)
+        let wide = CGRect(x: 0, y: 0, width: 2000, height: 800)
+        assertEquals(fancyPhases(from: right, to: wide), [CGRect(x: 0, y: 0, width: 1000, height: 800), wide])
+        // Shrinking while moving: shrink in place, then slide.
+        assertEquals(
+            fancyPhases(from: wide, to: right),
+            [CGRect(x: 0, y: 0, width: 1000, height: 800), right],
+        )
+        // Wider but shorter, and moved: shrink the height in place, slide, then widen in place.
+        let from = CGRect(x: 0, y: 0, width: 500, height: 800)
+        let to = CGRect(x: 600, y: 100, width: 900, height: 400)
+        assertEquals(fancyPhases(from: from, to: to), [
+            CGRect(x: 0, y: 0, width: 500, height: 400),
+            CGRect(x: 600, y: 100, width: 500, height: 400),
+            to,
+        ])
+    }
+
+    func testEachFancyPhaseNeedsOneKindOfWrite() {
+        let from = CGRect(x: 0, y: 0, width: 500, height: 800)
+        let to = CGRect(x: 600, y: 100, width: 900, height: 400)
+        var start = from
+        for phase in fancyPhases(from: from, to: to) {
+            assertNotEquals(PhaseWrites(from: start, to: phase), .both)
+            start = phase
+        }
+    }
+
+    func testAnimationGivesUpAfterTimeout() {
+        var animation = FrameAnimation(from: .zero, to: CGRect(x: 1000, y: 0, width: 0, height: 0))
+        assertTrue(animation.step(Spring(response: 1, damping: 0.9), dt: 1.0 / 30, timeout: 0.01))
+        assertEquals(animation.frame, CGRect(x: 1000, y: 0, width: 0, height: 0))
+    }
+
+    func testSpringIsIndependentOfStepSize() {
+        for damping in [0.7, 0.9, 1.0, 1.4] {
+            let spring = Spring(response: 0.15, damping: damping)
+            var coarse = 0.0, coarseVelocity = 0.0
+            var fine = 0.0, fineVelocity = 0.0
+            spring.step(&coarse, &coarseVelocity, to: 1000, dt: 0.1)
+            for _ in 0 ..< 12 { spring.step(&fine, &fineVelocity, to: 1000, dt: 1.0 / 120) }
+            XCTAssertEqual(coarse, fine, accuracy: 1e-8)
+            XCTAssertEqual(coarseVelocity, fineVelocity, accuracy: 1e-8)
+        }
+    }
+
+    func testSpringRemainsFiniteAfterLongPause() {
+        for damping in [0.7, 1.0, 1.4] {
+            var value = 0.0, velocity = 0.0
+            Spring(response: 0.001, damping: damping).step(&value, &velocity, to: 1000, dt: 10)
+            XCTAssertEqual(value, 1000, accuracy: 1e-8)
+            XCTAssertEqual(velocity, 0, accuracy: 1e-8)
+        }
+    }
+
+    func testPhaseRetargetPreservesMovingAxisMomentum() {
+        let spring = Spring(response: 0.15, damping: 0.9)
+        var animation = FrameAnimation(from: .zero, to: CGRect(x: 1000, y: 0, width: 0, height: 0))
+        _ = animation.step(spring, dt: 0.02, timeout: 1)
+        let current = animation.frame
+        let target = CGRect(x: 1500, y: 0, width: 0, height: 0)
+        animation.retarget(target, preserving: .position)
+        var restarted = FrameAnimation(from: current, to: target)
+        _ = animation.step(spring, dt: 0.01, timeout: 1)
+        _ = restarted.step(spring, dt: 0.01, timeout: 1)
+        XCTAssertGreaterThan(animation.frame.minX, restarted.frame.minX)
+    }
+
+    func testPhaseRetargetFreezesAxesNotWrittenByNextPhase() {
+        let spring = Spring(response: 0.15, damping: 0.9)
+        var animation = FrameAnimation(from: .zero, to: CGRect(x: 1000, y: 500, width: 800, height: 600))
+        _ = animation.step(spring, dt: 0.02, timeout: 1)
+        let current = animation.frame
+        animation.retarget(CGRect(origin: current.origin, size: CGSize(width: 1000, height: 800)), preserving: .size)
+        _ = animation.step(spring, dt: 0.02, timeout: 1)
+        assertEquals(animation.frame.origin, current.origin)
+    }
+
+    func testUnchangedFramesNeedNoAxWrite() {
+        let frame = CGRect(x: 10, y: 20, width: 800, height: 600)
+        XCTAssertNil(PhaseWrites.changed(from: frame, to: frame))
+        assertEquals(PhaseWrites.changed(from: frame, to: frame.offsetBy(dx: 1, dy: 0)), .position)
+        assertEquals(PhaseWrites.changed(from: frame, to: CGRect(origin: frame.origin, size: CGSize(width: 801, height: 600))), .size)
+    }
+
+    func testWriteCompletionCannotOverwriteCancellation() {
+        let write = AnimationWrite()
+        write.complete(.cancelled)
+        write.complete(.applied)
+        assertEquals(write.result, .cancelled)
+    }
+}
+
+@MainActor
+final class WindowAnimatorSchedulerTest: XCTestCase {
+    override func setUp() async throws { setUpWorkspacesForTests() }
+
+    private let from = CGRect(x: 0, y: 0, width: 400, height: 300)
+    private let moved = CGRect(x: 1000, y: 0, width: 400, height: 300)
+
+    private func makeWindow(_ id: UInt32 = 1) -> AnimationTestWindow {
+        AnimationTestWindow(id, Workspace.get(byName: name).rootTilingContainer)
+    }
+
+    func testSchedulerSkipsIdenticalRoundedFrames() {
+        let clock = AnimationTestClock()
+        let animator = WindowAnimator(animations: Animations(), clock: { clock.now })
+        let window = makeWindow()
+        animator.start(window.windowId, from: from, to: moved)
+        animator.step(now: clock.now)
+        assertEquals(window.animationFrames.count, 0)
+        clock.now = 0.00001
+        animator.step(now: clock.now)
+        assertEquals(window.animationFrames.count, 0)
+        animator.forget(window.windowId)
+    }
+
+    func testSchedulerWaitsForOutstandingWriteWithoutSubmittingMore() {
+        let clock = AnimationTestClock()
+        let animator = WindowAnimator(animations: Animations(), clock: { clock.now })
+        let window = makeWindow()
+        window.completeImmediately = false
+        animator.start(window.windowId, from: from, to: moved)
+        clock.now = 0.01
+        animator.step(now: clock.now)
+        clock.now = 0.05
+        animator.step(now: clock.now)
+        assertEquals(window.animationFrames.count, 1)
+        assertEquals(window.finalFrames.count, 0)
+        animator.forget(window.windowId)
+    }
+
+    func testSlowAndFastWritersSampleTheSameElapsedMotion() {
+        let clock = AnimationTestClock()
+        let animator = WindowAnimator(animations: Animations(), clock: { clock.now })
+        let slow = makeWindow(1)
+        let fast = makeWindow(2)
+        slow.completeImmediately = false
+        animator.start(slow.windowId, from: from, to: moved)
+        animator.start(fast.windowId, from: from, to: moved)
+        clock.now = 0.01
+        animator.step(now: clock.now)
+        for tick in 2 ... 5 {
+            clock.now = Double(tick) / 100
+            animator.step(now: clock.now)
+        }
+        slow.animationFrames.last?.write.complete(.applied)
+        clock.now = 0.06
+        animator.step(now: clock.now)
+        assertEquals(slow.animationFrames.last?.position, fast.animationFrames.last?.position)
+        animator.forget(slow.windowId)
+        animator.forget(fast.windowId)
+    }
+
+    func testDeadlineBoundsAllFancyPhasesAndQueuesFinalFrameOnce() {
+        let clock = AnimationTestClock()
+        let animator = WindowAnimator(animations: Animations(), clock: { clock.now })
+        let window = makeWindow()
+        let target = CGRect(x: 1000, y: 100, width: 800, height: 100)
+        animator.start(window.windowId, from: from, to: target)
+        clock.now = 0.01
+        animator.step(now: clock.now)
+        clock.now = 0.31
+        animator.step(now: clock.now)
+        animator.step(now: clock.now)
+        assertEquals(window.finalFrames, [target])
+        assertEquals(window.starts, 1)
+        assertEquals(window.ends, 1)
+        animator.forget(window.windowId)
+    }
+
+    func testHungWriterStopsGeneratingAnimationRequests() {
+        let clock = AnimationTestClock()
+        let animator = WindowAnimator(animations: Animations(), clock: { clock.now })
+        let window = makeWindow()
+        window.completeImmediately = false
+        animator.start(window.windowId, from: from, to: moved)
+        clock.now = 0.01
+        animator.step(now: clock.now)
+        clock.now = 0.12
+        animator.step(now: clock.now)
+        clock.now = 1
+        animator.step(now: clock.now)
+        assertEquals(window.animationFrames.count, 1)
+        assertEquals(window.finalFrames, [moved])
+        assertEquals(window.animationFrames[0].write.result, .cancelled)
+        assertEquals(window.ends, 1)
+    }
+
+    func testFailedWriterFallsBackToFinalFrame() {
+        let clock = AnimationTestClock()
+        let animator = WindowAnimator(animations: Animations(), clock: { clock.now })
+        let window = makeWindow()
+        window.completeImmediately = false
+        animator.start(window.windowId, from: from, to: moved)
+        clock.now = 0.01
+        animator.step(now: clock.now)
+        window.animationFrames.last?.write.complete(.failed)
+        clock.now = 0.02
+        animator.step(now: clock.now)
+        assertEquals(window.finalFrames, [moved])
+        assertEquals(window.ends, 1)
