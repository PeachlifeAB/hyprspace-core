#!/bin/bash
set -euo pipefail

runtime_root="$(cd "$(dirname "$0")" && pwd)"
source "$runtime_root/step-metadata.sh"
source "$runtime_root/presentation.sh"

apply_script="$runtime_root/apply-deinit-selections.sh"

ensure_runtime() {
    if [ ! -f "$apply_script" ]; then
        echo "ERROR: missing deinit runtime apply script at $apply_script" >&2
        exit 1
    fi
}

json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    value="${value//$'\b'/\\b}"
    value="${value//$'\f'/\\f}"
    printf '%s' "$value"
}

json_quote() {
    printf '"%s"' "$(json_escape "$1")"
}

json_array() {
    local first=1
    local item

    printf '['
    for item in "$@"; do
        if [ "$first" -eq 0 ]; then
            printf ', '
        fi
        json_quote "$item"
        first=0
    done
    printf ']'
}

array_length() {
    local __array_name="$1"
    local __array_length=0

    set +u
    eval "__array_length=\${#${__array_name}[@]}"
    set -u
    printf '%s' "$__array_length"
}

json_array_from_var() {
    local __array_name="$1"

    if [ "$(array_length "$__array_name")" -eq 0 ]; then
        json_array
    else
        eval "json_array \"\${${__array_name}[@]}\""
    fi
}

print_runtime_info() {
    local apply_script_exists=false
    if [ -f "$apply_script" ]; then
        apply_script_exists=true
    fi

    printf '{\n'
    printf '  "runtime_root": '
    json_quote "$runtime_root"
    printf ',\n'
    printf '  "apply_script": '
    json_quote "$apply_script"
    printf ',\n'
    printf '  "apply_script_exists": %s\n' "$apply_script_exists"
    printf '}\n'
}

read_lines_into_array() {
    local __target_var="$1"
    shift
    local __lines=()
    local __line

    while IFS= read -r __line; do
        __lines+=("$__line")
    done < <("$@")

    if [ "${#__lines[@]}" -eq 0 ]; then
        assign_named_array "$__target_var"
    else
        assign_named_array "$__target_var" "${__lines[@]}"
    fi
}

read_pipeline_into_array() {
    local __target_var="$1"
    local __lines=()
    local __line

    while IFS= read -r __line; do
        __lines+=("$__line")
    done

    if [ "${#__lines[@]}" -eq 0 ]; then
        assign_named_array "$__target_var"
    else
        assign_named_array "$__target_var" "${__lines[@]}"
    fi
}

assign_named_array() {
    local __target_var="$1"
    shift

    if [ "$#" -eq 0 ]; then
        eval "$__target_var=()"
        return 0
    fi

    local __assignment=""
    local __item
    local __quoted

    for __item in "$@"; do
        printf -v __quoted '%q' "$__item"
        __assignment+=" $__quoted"
    done

    eval "$__target_var=($__assignment)"
}

selection_includes() {
    local needle="$1"
    shift
    local item

    for item in "$@"; do
        if [ "$item" = "$needle" ]; then
            return 0
        fi
    done

    return 1
}

optional_keys_from_env() {
    local raw="${HYPRSPACE_DEINIT_TEST_SELECTIONS:-}"
    if [ -z "$raw" ]; then
        default_selected_keys
        return 0
    fi

    printf '%s\n' "$raw" | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$'
}

selection_payload() {
    local selected_keys=("$@")

    printf '{\n'
    printf '  "selected_steps": '
    json_array "${selected_keys[@]}"
    printf '\n}\n'
}

handle_test_mode() {
    local selected=()

    case "${HYPRSPACE_DEINIT_TEST_MODE}" in
        1|runtime)
            print_runtime_info
            ;;
        defaults)
            read_lines_into_array selected default_selected_keys
            selection_payload "${selected[@]}"
            ;;
        selection-preview)
            read_lines_into_array selected optional_keys_from_env
            selection_payload "${selected[@]}"
            ;;
        *)
            echo "ERROR: unknown HYPRSPACE_DEINIT_TEST_MODE=${HYPRSPACE_DEINIT_TEST_MODE}" >&2
            exit 1
            ;;
    esac
}

run_apply_script() {
    "$apply_script" "$@"
}

apply_selection() {
    local selected_steps=("$@")
    local flags=()

    local key
    for key in "${selected_steps[@]}"; do
        flags+=("--with-${key//_/-}")
    done

    local all_key
    for all_key in "${DEINIT_STEP_KEYS[@]}"; do
        if ! selection_includes "$all_key" "${selected_steps[@]}"; then
            flags+=("--without-${all_key//_/-}")
        fi
    done

    if [ "${#flags[@]}" -eq 0 ]; then
        run_apply_script
    else
        run_apply_script "${flags[@]}"
    fi
}

run_interactive_selection() {
    ensure_gum_available

    local deinit_labels=()
    local selected_csv
    local output
    local selected_steps

    render_banner
    echo

    render_section_header "Warning"
    printf '%s\n' "This will remove Hyprspace and selected components from your system."
    printf '%s\n' "Configs are backed up before deletion."
    echo

    read_lines_into_array default_labels default_selected_labels
    read_lines_into_array deinit_labels deinit_step_labels
    selected_csv="$(IFS=,; printf '%s' "${default_labels[*]}")"

    if output="$(gum choose --no-limit --header "Select components to remove" --selected="$selected_csv" --cursor "> " --cursor-prefix "[ ] " --selected-prefix "[x] " --unselected-prefix "[ ] " "${deinit_labels[@]}")"; then
        :
    else
        local exit_code=$?
        if [ "$exit_code" -eq 130 ]; then
            exit 130
        fi
        exit "$exit_code"
    fi

    read_pipeline_into_array selected_steps < <(printf '%s\n' "$output" | grep -v '^$' | while read -r label; do step_key_for_label "$label" >/dev/null; step_key_for_label "$label"; done)

    render_banner
    echo
    local selected_labels_text
    selected_labels_text="$(selected_step_labels "${selected_steps[@]}")"
    render_summary "$selected_labels_text"
    echo

    if gum confirm "Proceed with removal?" --default=false; then
        :
    else
        local exit_code=$?
        if [ "$exit_code" -eq 130 ]; then
            exit 130
        fi
        printf '%s\n' "Cancelled."
        exit "$exit_code"
    fi

    apply_selection "${selected_steps[@]}"
    render_completion
}

usage() {
    cat <<'EOF'
Usage: hyprspace deinit

Interactive teardown of Hyprspace and its managed components.
Lets you choose which components to remove (Sketchybar, JankyBorders,
config, wallpaper, macOS defaults, Homebrew taps).

Core Hyprspace traces (app bundles, CLI binaries, launch agents, shell
completions, Homebrew packages) are always removed. The menu bar is
always restored.

Options:
  -h, --help    Show this help
EOF
}

main() {
    ensure_runtime

    if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
        usage
        exit 0
    fi

    if [ -n "${HYPRSPACE_DEINIT_TEST_MODE:-}" ]; then
        handle_test_mode
        return 0
    fi

    if [ "${HYPRSPACE_DEINIT_ASSUME_DEFAULTS:-0}" = "1" ]; then
        read_lines_into_array selected default_selected_keys
        apply_selection "${selected[@]}"
        return 0
    fi

    run_interactive_selection
}

main "$@"
