#!/bin/bash
set -euo pipefail

runtime_root="$(cd "$(dirname "$0")" && pwd)"
source "$runtime_root/step-metadata.sh"
source "$runtime_root/presentation.sh"

apply_script="$runtime_root/apply-init-selections.sh"

ensure_runtime() {
    if [ ! -f "$apply_script" ]; then
        echo "ERROR: missing init runtime apply script at $apply_script" >&2
        exit 1
    fi
}

json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    value="${value//$'\b'/\\b}"
    value="${value//$'\f'/\\f}"
    printf '%s' "$value"
}

json_quote() {
    printf '"%s"' "$(json_escape "$1")"
}

json_array() {
    local first=1
    local item

    printf '['
    for item in "$@"; do
        if [ "$first" -eq 0 ]; then
            printf ', '
        fi
        json_quote "$item"
        first=0
    done
    printf ']'
}

array_length() {
    local __array_name="$1"
    local __array_length=0

    set +u
    eval "__array_length=\${#${__array_name}[@]}"
    set -u
    printf '%s' "$__array_length"
}

json_array_from_var() {
    local __array_name="$1"

    if [ "$(array_length "$__array_name")" -eq 0 ]; then
        json_array
    else
        eval "json_array \"\${${__array_name}[@]}\""
    fi
}

print_runtime_info() {
    local apply_script_exists=false
    if [ -f "$apply_script" ]; then
        apply_script_exists=true
    fi

    printf '{\n'
    printf '  "runtime_root": '
    json_quote "$runtime_root"
    printf ',\n'
    printf '  "apply_script": '
    json_quote "$apply_script"
    printf ',\n'
    printf '  "apply_script_exists": %s\n' "$apply_script_exists"
    printf '}\n'
}

read_lines_into_array() {
    local __target_var="$1"
    shift
    local __lines=()
    local __line

    while IFS= read -r __line; do
        __lines+=("$__line")
    done < <("$@")

    if [ "${#__lines[@]}" -eq 0 ]; then
        assign_named_array "$__target_var"
    else
        assign_named_array "$__target_var" "${__lines[@]}"
    fi
}

read_pipeline_into_array() {
    local __target_var="$1"
    local __lines=()
    local __line

    while IFS= read -r __line; do
        __lines+=("$__line")
    done

    if [ "${#__lines[@]}" -eq 0 ]; then
        assign_named_array "$__target_var"
    else
        assign_named_array "$__target_var" "${__lines[@]}"
    fi
}

assign_named_array() {
    local __target_var="$1"
    shift

    if [ "$#" -eq 0 ]; then
        eval "$__target_var=()"
        return 0
    fi

    local __assignment=""
    local __item
    local __quoted

    for __item in "$@"; do
        printf -v __quoted '%q' "$__item"
        __assignment+=" $__quoted"
    done

    eval "$__target_var=($__assignment)"
}

optional_keys_from_env() {
    local raw="${HYPRSPACE_INIT_TEST_SELECTIONS:-}"
    if [ -z "$raw" ]; then
        default_selected_keys
        return 0
    fi

    printf '%s\n' "$raw" | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$'
}

test_terminal_app() {
    local value="${HYPRSPACE_INIT_TEST_TERMINAL_APP:-$(default_terminal_app)}"
    if ! validate_terminal_app "$value"; then
        echo "ERROR: invalid HYPRSPACE_INIT_TEST_TERMINAL_APP=$value" >&2
        exit 1
    fi
    printf '%s\n' "$value"
}

test_music_app() {
    local value="${HYPRSPACE_INIT_TEST_MUSIC_APP:-$(default_music_app)}"
    if ! validate_music_app "$value"; then
        echo "ERROR: invalid HYPRSPACE_INIT_TEST_MUSIC_APP=$value" >&2
        exit 1
    fi
    printf '%s\n' "$value"
}

test_browser_app() {
    local value="${HYPRSPACE_INIT_TEST_BROWSER_APP:-$(default_browser_app)}"
    if ! validate_browser_app "$value"; then
        echo "ERROR: invalid HYPRSPACE_INIT_TEST_BROWSER_APP=$value" >&2
        exit 1
    fi
    printf '%s\n' "$value"
}

selection_payload() {
    local terminal_app="$1"
    local music_app="$2"
    local browser_app="$3"
    shift 3
    local selected_keys=("$@")
    local mandatory_keys=()
    local apply_flags=()

    read_lines_into_array mandatory_keys mandatory_step_keys
    read_lines_into_array apply_flags build_apply_flags "${selected_keys[@]}"

    printf '{\n'
    printf '  "selected_optional_steps": '
    json_array "${selected_keys[@]}"
    printf ',\n'
    printf '  "mandatory_steps": '
    json_array_from_var mandatory_keys
    printf ',\n'
    printf '  "terminal_app": '
    json_quote "$terminal_app"
    printf ',\n'
    printf '  "music_app": '
    json_quote "$music_app"
    printf ',\n'
    printf '  "browser_app": '
    json_quote "$browser_app"
    printf ',\n'
    printf '  "apply_flags": '
    json_array_from_var apply_flags
    printf '\n}\n'
}

handle_test_mode() {
    local terminal_app
    local music_app
    local browser_app
    local selected=()

    case "${HYPRSPACE_INIT_TEST_MODE}" in
        1|runtime)
            print_runtime_info
            ;;
        defaults)
            read_lines_into_array selected default_selected_keys
            terminal_app="$(default_terminal_app)"
            music_app="$(default_music_app)"
            browser_app="$(default_browser_app)"
            selection_payload "$terminal_app" "$music_app" "$browser_app" "${selected[@]}"
            ;;
        selection-preview)
            read_lines_into_array selected optional_keys_from_env
            terminal_app="$(test_terminal_app)"
            music_app="$(test_music_app)"
            browser_app="$(test_browser_app)"
            selection_payload "$terminal_app" "$music_app" "$browser_app" "${selected[@]}"
            ;;
        *)
            echo "ERROR: unknown HYPRSPACE_INIT_TEST_MODE=${HYPRSPACE_INIT_TEST_MODE}" >&2
            exit 1
            ;;
    esac
}

selection_includes() {
    local needle="$1"
    shift
    local item

    for item in "$@"; do
        if [ "$item" = "$needle" ]; then
            return 0
        fi
    done

    return 1
}

run_apply_script() {
    local terminal_app="$1"
    local music_app="$2"
    local browser_app="$3"
    shift 3

    HYPRSPACE_SELECTED_TERMINAL_APP="$terminal_app" \
    HYPRSPACE_SELECTED_MUSIC_APP="$music_app" \
    HYPRSPACE_SELECTED_BROWSER_APP="$browser_app" \
    "$apply_script" "$@"
}

hyprspace_app_path() {
    local app_dir

    if [ -n "${HYPRSPACE_APP_PATH_OVERRIDE:-}" ]; then
        printf '%s\n' "$HYPRSPACE_APP_PATH_OVERRIDE"
        return 0
    fi

    app_dir="${runtime_root%/Contents/Resources/libexec/hyprspace-init}"

    if [ "$app_dir" != "$runtime_root" ] && [ -d "$app_dir" ]; then
        printf '%s\n' "$app_dir"
        return 0
    fi

    if [ -d "/Applications/Hyprspace.app" ]; then
        printf '%s\n' "/Applications/Hyprspace.app"
        return 0
    fi

    echo "ERROR: unable to locate Hyprspace.app for launch" >&2
    return 1
}

launch_hyprspace_app() {
    local app_path
    app_path="$(hyprspace_app_path)"
    echo "-> Launching Hyprspace.app..."
    open "$app_path"

    local timeout_s=10
    local started_at current_at
    started_at="$(date +%s)"
    while true; do
        if pgrep -x "Hyprspace" >/dev/null 2>&1; then
            return 0
        fi

        current_at="$(date +%s)"
        if ((current_at - started_at >= timeout_s)); then
            echo "ERROR: Hyprspace.app launch did not produce a running Hyprspace process within ${timeout_s}s ($app_path)" >&2
            return 1
        fi

        sleep 1
    done
}

reload_sketchybar() {
    if ! command -v sketchybar >/dev/null 2>&1; then
        echo "-> sketchybar not found, skipping reload."
        return 0
    fi

    echo "-> Reloading sketchybar..."
    sketchybar --reload
}

complete_setup() {
    launch_hyprspace_app
    reload_sketchybar
    render_completion
}

apply_selection() {
    local terminal_app="$1"
    local music_app="$2"
    local browser_app="$3"
    shift 3
    local selected_optional_steps=("$@")
    local apply_flags=()

    read_lines_into_array apply_flags build_apply_flags "${selected_optional_steps[@]}"

    if [ "$(array_length apply_flags)" -eq 0 ]; then
        run_apply_script "$terminal_app" "$music_app" "$browser_app"
    else
        run_apply_script "$terminal_app" "$music_app" "$browser_app" "${apply_flags[@]}"
    fi
}

choose_single_value() {
    local header="$1"
    local default_value="$2"
    shift 2
    local output
    local exit_code

    if output="$(gum choose --header "$header" --selected="$default_value" "$@")"; then
        printf '%s\n' "$output"
        return 0
    fi

    exit_code=$?
    if [ "$exit_code" -eq 130 ]; then
        exit 130
    fi
    exit "$exit_code"
}

choose_single_from_command() {
    local header="$1"
    local default_value="$2"
    shift 2
    local options=()

    read_lines_into_array options "$@"
    choose_single_value "$header" "$default_value" "${options[@]}"
}

run_interactive_selection() {
    ensure_gum_available

    local optional_labels=()
    local selected_csv
    local output
    local selected_optional_lines
    local mandatory_lines
    local apply_flags_lines
    local terminal_app
    local music_app
    local browser_app

    render_banner
    echo
    render_welcome
    echo

    read_lines_into_array default_labels default_selected_labels
    read_lines_into_array optional_labels optional_step_labels
    selected_csv="$(IFS=,; printf '%s' "${default_labels[*]}")"

    if output="$(gum choose --no-limit --header "Optional integrations" --selected="$selected_csv" --cursor "> " --cursor-prefix "[ ] " --selected-prefix "[✓] " --unselected-prefix "[ ] " "${optional_labels[@]}")"; then
        :
    else
        local exit_code=$?
        if [ "$exit_code" -eq 130 ]; then
            exit 130
        fi
        exit "$exit_code"
    fi

    read_pipeline_into_array selected_optional < <(printf '%s\n' "$output" | grep -v '^$' | while read -r label; do step_key_for_label "$label" >/dev/null; step_key_for_label "$label"; done)

    terminal_app="$(choose_single_from_command "Preferred terminal" "$(default_terminal_app)" terminal_app_choices)"
    music_app="$(choose_single_from_command "Preferred music app" "$(default_music_app)" music_app_choices)"
    browser_app="$(choose_single_from_command "Preferred browser" "$(default_browser_app)" browser_app_choices)"

    render_banner
    echo
    selected_optional_lines="$(selected_step_labels "${selected_optional[@]}")"
    mandatory_lines="$(mandatory_step_keys | while read -r key; do step_label "$key"; done)"
    apply_flags_lines="$(build_apply_flags "${selected_optional[@]}" | tr '\n' ' ' | sed 's/ $//')"
    render_summary "$selected_optional_lines" "$mandatory_lines" "$terminal_app" "$music_app" "$browser_app" "$apply_flags_lines"
    echo

    if gum confirm "Apply this setup?" --default=true; then
        :
    else
        local exit_code=$?
        exit "$exit_code"
    fi

    apply_selection "$terminal_app" "$music_app" "$browser_app" "${selected_optional[@]}"
    complete_setup
}

main() {
    ensure_runtime

    if [ -n "${HYPRSPACE_INIT_TEST_MODE:-}" ]; then
        handle_test_mode
        return 0
    fi

    if [ "${HYPRSPACE_INIT_ASSUME_DEFAULTS:-0}" = "1" ]; then
        read_lines_into_array selected default_selected_keys
        apply_selection "$(default_terminal_app)" "$(default_music_app)" "$(default_browser_app)" "${selected[@]}"
        complete_setup
        return 0
    fi

    run_interactive_selection
}

main "$@"
